---
import GithubIcon from '~/components/GithubIcon.astro';
import Logo from '~/components/Logo.astro';
import StickmanHero from '~/components/StickmanHero.astro';
import Base from '~/layouts/Base.astro';
import { games } from '~/lib/games';
import { absoluteUrl, SITE } from '~/lib/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: SITE.name,
  itemListElement: games.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: absoluteUrl(`/${g.slug}`),
    name: g.name,
  })),
};
---

<Base title={`${SITE.name} · ${SITE.tagline}`} description={SITE.description} path='/' jsonLd={jsonLd}>
  <main class='mx-auto max-w-[1120px] px-4 pt-[calc(env(safe-area-inset-top,0px)+1.5rem)] pb-[calc(env(safe-area-inset-bottom,0px)+0.25rem)] sm:px-8 sm:pt-16'>
    <section class='grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4'>
      <header
        class='col-span-2 flex flex-col justify-center rounded-2xl border border-amber-ink/20 bg-butter-soft p-4 sm:px-7 sm:py-6 shadow-xs'
      >
        <StickmanHero />
      </header>

      {
        games.map((game) => (
          <a
            href={`/${game.slug}`}
            data-game-slug={game.slug}
            data-game-name={game.name}
            class='group relative flex flex-col rounded-2xl border border-neutral-200 bg-white p-2 transition-colors hover:border-neutral-300'
          >
            <div class='relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-xl bg-white'>
              <img src={`/thumbs/${game.slug}.webp`} alt='' loading='lazy' class='h-[78%] w-[84%] object-contain' />
            </div>
            <div class='px-2 pt-3 pb-2'>
              <h2 class='font-display text-[17px] leading-tight sm:text-[18px]'>{game.name}</h2>
              <p class='mt-1 text-[13px] leading-snug text-neutral-500'>{game.tagline}</p>
            </div>
          </a>
        ))
      }

      <!-- Thẻ Game Mới Sắp Ra Mắt lấp đầy ô trống thẩm mỹ -->
      <div
        class='group relative flex flex-col justify-between rounded-2xl border border-dashed border-amber-300/80 bg-amber-50/40 p-2 text-center transition-colors'
      >
        <div class='relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-xl bg-white/80'>
          <svg viewBox="0 0 100 100" class="h-16 w-16" fill="none" stroke="#1f2329" stroke-linecap="round" stroke-linejoin="round">
            <!-- Head -->
            <circle cx="50" cy="28" r="9" stroke-width="3" fill="#fde68a" />
            <!-- Face -->
            <circle cx="47" cy="27" r="1.2" fill="#1f2329" stroke="none" />
            <circle cx="53" cy="27" r="1.2" fill="#1f2329" stroke="none" />
            <path d="M 47 31 Q 50 34 53 31" stroke-width="1.5" />
            <!-- Body -->
            <path d="M 50 37 L 50 60" stroke-width="3" />
            <!-- Arms holding gamepad -->
            <path d="M 50 45 L 39 50 L 44 54" stroke-width="2.5" />
            <path d="M 50 45 L 61 50 L 56 54" stroke-width="2.5" />
            <!-- Mini Controller -->
            <rect x="42" y="51" width="16" height="8" rx="3" fill="#1f2329" stroke="#1f2329" stroke-width="2" />
            <circle cx="46" cy="55" r="1" fill="#fcd34d" stroke="none" />
            <circle cx="54" cy="55" r="1" fill="#ef4444" stroke="none" />
            <!-- Legs sitting -->
            <path d="M 50 60 L 37 74 L 45 76" stroke-width="3" />
            <path d="M 50 60 L 63 74 L 55 76" stroke-width="3" />
            <!-- Sparkles -->
            <path d="M 28 22 L 30 18 L 32 22 L 36 24 L 32 26 L 30 30 L 28 26 L 24 24 Z" fill="#f59e0b" stroke="none" />
            <path d="M 72 24 L 73 21 L 74 24 L 77 25 L 74 26 L 73 29 L 72 26 L 69 25 Z" fill="#f59e0b" stroke="none" />
          </svg>
        </div>
        <div class='px-2 pt-2.5 pb-2'>
          <h2 class='font-display text-[16px] leading-tight text-amber-950 sm:text-[17px]'>Sắp Ra Mắt...</h2>
          <p class='mt-1 text-[12px] leading-snug text-amber-800/80'>Mini game mới đang phát triển!</p>
        </div>
      </div>
    </section>

    <footer class='mt-3 pb-1 flex flex-col items-center text-center'>
      <p class='text-[12px] font-medium leading-tight text-stone-600'>Copyright © Huy Tran</p>
      <p class='mt-0.5 text-[10.5px] leading-tight text-stone-400'>Sticker Man Arcade · All rights reserved</p>
    </footer>
  </main>

  <!-- Full-screen In-App Game Player for Mobile -->
  <div id='game-modal' class='fixed inset-0 z-50 hidden bg-white'>
    <iframe
      id='modal-game-frame'
      title='Game View'
      allow='camera; microphone; fullscreen; autoplay; web-share; clipboard-write'
      class='w-full h-full border-0 block bg-white'
    ></iframe>
  </div>

  <script is:inline>
    {
      const modal = document.getElementById('game-modal');
      const frame = document.getElementById('modal-game-frame');

      function openGame(slug) {
        if (!modal || !frame) return;
        frame.src = `/games/${slug}.html`;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        
        // Listen for when game finishes loading
        frame.addEventListener(
          'load',
          () => {
            frame.contentWindow?.focus();
            try {
              // Intercept the game's native "← all games" link to close modal smoothly with zero latency
              frame.contentDocument?.querySelectorAll('a[href="/"]').forEach((link) => {
                link.addEventListener('click', (ev) => {
                  ev.preventDefault();
                  closeGame();
                });
              });
            } catch (err) {}
          },
          { once: true }
        );
      }

      function closeGame() {
        if (!modal || !frame) return;
        frame.src = 'about:blank';
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }

      // Also listen for popstate or messages
      window.addEventListener('message', (ev) => {
        if (ev.data === 'close-game') closeGame();
      });

      document.querySelectorAll('[data-game-slug]').forEach((card) => {
        card.addEventListener('click', (e) => {
          e.preventDefault();
          const slug = card.getAttribute('data-game-slug');
          if (slug) {
            openGame(slug);
          }
        });
      });

      // Quick Action Buttons
      const allCards = Array.from(document.querySelectorAll('[data-game-slug]'));
      const quickBtn = document.getElementById('quick-play-btn');
      const topPickBtn = document.getElementById('top-pick-btn');

      quickBtn?.addEventListener('click', () => {
        if (allCards.length > 0) {
          const randomCard = allCards[Math.floor(Math.random() * allCards.length)];
          const slug = randomCard.getAttribute('data-game-slug');
          if (slug) openGame(slug);
        }
      });

      topPickBtn?.addEventListener('click', () => {
        openGame('punching');
      });
    }
  </script>
</Base>
