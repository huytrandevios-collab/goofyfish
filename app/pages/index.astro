  <script is:inline>
    {
      const modal = document.getElementById('game-modal');
      const frame = document.getElementById('modal-game-frame');
      const closeBtn = document.getElementById('modal-close-btn');

      const scorecardModal = document.getElementById('scorecard-modal');
      const scorecardImg = document.getElementById('scorecard-img');
      const scorecardShareBtn = document.getElementById('scorecard-share-btn');
      const scorecardSaveBtn = document.getElementById('scorecard-save-btn');
      const scorecardCloseBtn = document.getElementById('scorecard-close-btn');
      const scorecardTopCloseBtn = document.getElementById('scorecard-top-close-btn');

      let currentBlobUrl = null;
      let currentFile = null;

      function openScorecard(blobUrl, filename) {
        if (!scorecardModal || !scorecardImg) return;
        currentBlobUrl = blobUrl;
        scorecardImg.src = blobUrl;
        scorecardModal.style.display = 'flex';
        scorecardModal.classList.remove('hidden');

        fetch(blobUrl)
          .then((r) => r.blob())
          .then((blob) => {
            currentFile = new File([blob], filename || 'stickerman-score.png', { type: 'image/png' });
          })
          .catch(() => {});
      }

      window.openScorecard = openScorecard;

      function closeScorecard() {
        if (!scorecardModal) return;
        scorecardModal.style.display = 'none';
        scorecardModal.classList.add('hidden');
      }

      scorecardCloseBtn?.addEventListener('click', closeScorecard);
      scorecardTopCloseBtn?.addEventListener('click', closeScorecard);

      // Nút Chia sẻ Mạng Xã Hội (Facebook, Zalo, Messages, AirDrop, Instagram, ...)
      scorecardShareBtn?.addEventListener('click', async () => {
        if (currentFile && navigator.canShare && navigator.canShare({ files: [currentFile] })) {
          try {
            await navigator.share({
              files: [currentFile],
              title: 'Stickman War',
              text: 'Kỷ lục Stickman War của tôi! Thử đánh bại tôi xem nào 🎮'
            });
          } catch (e) {
            console.log('Share dismissed or failed', e);
          }
        } else if (navigator.share) {
          try {
            await navigator.share({
              title: 'Stickman War',
              text: 'Kỷ lục Stickman War của tôi! 🎮',
              url: window.location.href
            });
          } catch (e) {}
        } else if (currentBlobUrl) {
          // Fallback download if share not supported
          saveImageDirectly();
        }
      });

      function saveImageDirectly() {
        if (currentBlobUrl) {
          const a = document.createElement('a');
          a.href = currentBlobUrl;
          a.download = currentFile?.name || 'stickerman-score.png';
          document.body.appendChild(a);
          a.click();
          a.remove();
        }
      }

      scorecardSaveBtn?.addEventListener('click', saveImageDirectly);

      window.closeGame = closeGame;

      function setHomeButtonVisible(visible) {
        if (closeBtn) {
          closeBtn.style.display = visible ? 'flex' : 'none';
        }
      }
      window.setHomeButtonVisible = setHomeButtonVisible;

      if (closeBtn) {
        closeBtn.onclick = (e) => {
          e.preventDefault();
          closeGame();
        };
      }

      // ==========================================
      // PER-GAME LEADERBOARDS & PLAY COUNTS SYSTEM
      // ==========================================
      const ALL_GAMES_INFO = [
        { slug: 'punching', name: 'Goon Rush', unit: 'KOs', thresholds: [15, 35, 65, 100] },
        { slug: 'rolling', name: 'Keep Rolling', unit: 'm', thresholds: [400, 1000, 2500, 4500] },
        { slug: 'swinging', name: 'Ninja Swing', unit: 'pts', thresholds: [15, 30, 50, 80] },
        { slug: 'chopping', name: 'Timber', unit: 'pts', thresholds: [25, 55, 95, 150] },
        { slug: 'stacks', name: 'Crane Drop', unit: 'tầng', thresholds: [12, 25, 45, 75] },
        { slug: 'skirmish', name: 'Skirmish', unit: 'round', thresholds: [5, 12, 22, 35] },
        { slug: 'hoops', name: 'Ten Balls', unit: 'pts', thresholds: [15, 28, 42, 60] },
        { slug: 'typing', name: 'Type Fight', unit: 'wpm', thresholds: [15, 28, 45, 70] },
        { slug: 'slicing', name: 'Picnic Panic', unit: 'pts', thresholds: [20, 45, 80, 120] },
        { slug: 'knockdown', name: 'Knockdown', unit: 'cửa', thresholds: [8, 16, 26, 38] },
        { slug: 'stomping', name: 'Floor Is Spikes', unit: 'pts', thresholds: [18, 35, 60, 95] },
        { slug: 'crossing', name: 'Hop Across', unit: 'bước', thresholds: [25, 50, 90, 140] },
        { slug: 'gaps', name: 'Mind the Gap', unit: 'cầu', thresholds: [10, 22, 38, 60] },
        { slug: 'slowmo', name: 'Slow Mo Hop', unit: 'pts', thresholds: [12, 25, 42, 65] },
        { slug: 'planks', name: 'Chop Stack', unit: 'tầng', thresholds: [12, 24, 40, 65] },
        { slug: 'bopping', name: 'Keep It Up', unit: 'bops', thresholds: [15, 30, 55, 85] },
        { slug: 'glider', name: 'Paper Glider', unit: 'phòng', thresholds: [8, 18, 32, 50] },
        { slug: 'stones', name: 'Stepping Stones', unit: 'đá', thresholds: [14, 28, 48, 75] },
        { slug: 'mirror', name: 'Mirror', unit: 'dáng', thresholds: [10, 20, 35, 55] },
        { slug: 'selves', name: 'Past Selves', unit: 'màn', thresholds: [6, 12, 18, 24] }
      ];

      const DEFAULT_PLAY_COUNTS = {
        punching: 1840,
        rolling: 1520,
        swinging: 1350,
        chopping: 1180,
        stacks: 990,
        skirmish: 910,
        hoops: 860,
        typing: 810,
        slicing: 740,
        knockdown: 680,
        stomping: 620,
        crossing: 580,
        gaps: 520,
        slowmo: 490,
        planks: 440,
        bopping: 410,
        glider: 370,
        stones: 340,
        mirror: 300,
        selves: 260
      };

      const DEFAULT_GAME_SCORES = {
        punching: 120,
        rolling: 1240,
        swinging: 32,
        chopping: 48,
        stacks: 24,
        skirmish: 14,
        hoops: 28,
        typing: 18,
        slicing: 52,
        knockdown: 22,
        stomping: 30,
        crossing: 36,
        gaps: 18,
        slowmo: 26,
        planks: 21,
        bopping: 35,
        glider: 16,
        stones: 24,
        mirror: 19,
        selves: 10
      };

      function getPlayCounts() {
        try {
          const raw = localStorage.getItem('stickman_play_counts');
          if (raw) return Object.assign({}, DEFAULT_PLAY_COUNTS, JSON.parse(raw));
        } catch (e) {}
        return Object.assign({}, DEFAULT_PLAY_COUNTS);
      }

      function getGameScores() {
        try {
          const raw = localStorage.getItem('stickman_game_scores');
          if (raw) return Object.assign({}, DEFAULT_GAME_SCORES, JSON.parse(raw));
        } catch (e) {}
        return Object.assign({}, DEFAULT_GAME_SCORES);
      }

      function incrementGamePlay(slug) {
        const counts = getPlayCounts();
        counts[slug] = (counts[slug] || 0) + 1;
        try {
          localStorage.setItem('stickman_play_counts', JSON.stringify(counts));
        } catch (e) {}
        updateHomepageCardsUI();
        if (currentSelectedGameSlug === slug) {
          renderSelectedGameRank(slug);
        }
      }

      function saveGameScore(slug, score) {
        if (!score || score <= 0) return;
        const scores = getGameScores();
        const currentBest = scores[slug] || 0;
        if (score > currentBest) {
          scores[slug] = score;
          try {
            localStorage.setItem('stickman_game_scores', JSON.stringify(scores));
          } catch (e) {}

          // Submit to Apple Game Center per-game leaderboard
          if (GameCenter && GameCenter.submitScore) {
            GameCenter.submitScore({
              score: score,
              leaderboardID: 'stickman_war_' + slug
            }).catch(() => {});
          }

          // Award War Points
          const addPoints = Math.max(5, Math.floor(score / 3));
          const currentWp = getWarPoints();
          localStorage.setItem('stickman_war_points', (currentWp + addPoints).toString());
          updateRankUI();
          updateHomepageCardsUI();

          if (currentSelectedGameSlug === slug) {
            renderSelectedGameRank(slug);
          }
        }
      }

      function getGameRankTier(slug, score) {
        const info = ALL_GAMES_INFO.find((g) => g.slug === slug) || { unit: 'pts', thresholds: [15, 35, 65, 100] };
        const t = info.thresholds;
        const unit = info.unit;

        if (score < t[0]) {
          return {
            badge: '🥉',
            rankTitle: 'Tân Binh Đồng',
            shortTitle: 'Đồng',
            currTierLbl: `Đồng (0 ${unit})`,
            nextTierLbl: `Mục tiêu: Bạc (${t[0]} ${unit})`,
            progress: Math.min(100, Math.round((score / t[0]) * 100))
          };
        } else if (score < t[1]) {
          return {
            badge: '🥈',
            rankTitle: 'Chiến Binh Bạc',
            shortTitle: 'Bạc',
            currTierLbl: `Bạc (${t[0]} ${unit})`,
            nextTierLbl: `Mục tiêu: Vàng (${t[1]} ${unit})`,
            progress: Math.min(100, Math.round(((score - t[0]) / (t[1] - t[0])) * 100))
          };
        } else if (score < t[2]) {
          return {
            badge: '🥇',
            rankTitle: 'Đấu Sĩ Vàng',
            shortTitle: 'Vàng',
            currTierLbl: `Vàng (${t[1]} ${unit})`,
            nextTierLbl: `Mục tiêu: Kim Cương (${t[2]} ${unit})`,
            progress: Math.min(100, Math.round(((score - t[1]) / (t[2] - t[1])) * 100))
          };
        } else if (score < t[3]) {
          return {
            badge: '💎',
            rankTitle: 'Bậc Thầy Kim Cương',
            shortTitle: 'Kim Cương',
            currTierLbl: `Kim Cương (${t[2]} ${unit})`,
            nextTierLbl: `Mục tiêu: Chiến Thần (${t[3]} ${unit})`,
            progress: Math.min(100, Math.round(((score - t[2]) / (t[3] - t[2])) * 100))
          };
        } else {
          return {
            badge: '👑',
            rankTitle: 'Chiến Thần Tối Cao',
            shortTitle: 'Chiến Thần',
            currTierLbl: `Chiến Thần (>${t[3]} ${unit})`,
            nextTierLbl: 'Cấp Bậc Tối Thượng 🏆',
            progress: 100
          };
        }
      }

      // Format numbers cleanly (e.g. 1520 -> 1.5k)
      function formatCount(num) {
        if (num >= 1000) return (num / 1000).toFixed(1).replace('.0', '') + 'k';
        return num.toString();
      }

      // Update Homepage Game Cards (Play count, Rank Badges, Hot Badges)
      function updateHomepageCardsUI() {
        const counts = getPlayCounts();
        const scores = getGameScores();

        // Find top 3 played games
        const sortedSlugsByPlay = Object.keys(counts).sort((a, b) => (counts[b] || 0) - (counts[a] || 0));
        const top1 = sortedSlugsByPlay[0];
        const top2 = sortedSlugsByPlay[1];
        const top3 = sortedSlugsByPlay[2];

        document.querySelectorAll('.game-card').forEach((card) => {
          const slug = card.getAttribute('data-game-slug');
          if (!slug) return;

          const playCount = counts[slug] || 0;
          const bestScore = scores[slug] || 0;
          const tier = getGameRankTier(slug, bestScore);

          // Update play count number
          const playsNumEl = card.querySelector('.plays-count-num');
          if (playsNumEl) playsNumEl.textContent = formatCount(playCount);

          // Update rank badge on top-right
          const rankBadgeIcon = card.querySelector('.rank-badge-icon');
          const rankBadgeText = card.querySelector('.rank-badge-text');
          if (rankBadgeIcon) rankBadgeIcon.textContent = tier.badge;
          if (rankBadgeText) rankBadgeText.textContent = tier.shortTitle || 'Đồng';

          // Update Hot Badge on top-left
          const hotBadge = card.querySelector('.game-hot-badge');
          const hotText = card.querySelector('.hot-badge-text');
          if (hotBadge && hotText) {
            if (slug === top1) {
              hotBadge.style.display = 'inline-flex';
              hotBadge.className = 'game-hot-badge absolute top-1.5 left-1.5 z-10 max-w-[48%] inline-flex items-center gap-0.5 rounded-md border border-stone-900 bg-rose-500 px-1.5 py-0.5 text-[9px] font-black text-white shadow-xs select-none';
              hotText.textContent = '🔥 Top 1';
            } else if (slug === top2) {
              hotBadge.style.display = 'inline-flex';
              hotBadge.className = 'game-hot-badge absolute top-1.5 left-1.5 z-10 max-w-[48%] inline-flex items-center gap-0.5 rounded-md border border-stone-900 bg-amber-500 px-1.5 py-0.5 text-[9px] font-black text-stone-950 shadow-xs select-none';
              hotText.textContent = '⚡ Top 2';
            } else if (slug === top3) {
              hotBadge.style.display = 'inline-flex';
              hotBadge.className = 'game-hot-badge absolute top-1.5 left-1.5 z-10 max-w-[48%] inline-flex items-center gap-0.5 rounded-md border border-stone-900 bg-amber-300 px-1.5 py-0.5 text-[9px] font-black text-stone-900 shadow-xs select-none';
              hotText.textContent = '⭐ Top 3';
            } else {
              hotBadge.style.display = 'none';
            }
          }
        });
      }

      // Classification & Sorting on Homepage
      const sortContainer = document.getElementById('games-grid-container');
      const sortMostPlayedBtn = document.getElementById('tab-sort-most-played');
      const sortTopScoreBtn = document.getElementById('tab-sort-top-score');
      const sortDefaultBtn = document.getElementById('tab-sort-default');

      function setSortActiveTab(activeBtn) {
        [sortMostPlayedBtn, sortTopScoreBtn, sortDefaultBtn].forEach((btn) => {
          if (!btn) return;
          if (btn === activeBtn) {
            btn.className = 'sort-tab-btn flex items-center gap-1 px-2.5 py-1 rounded-xl text-[11px] font-bold border-2 border-stone-800 bg-[#fde68a] text-stone-900 shadow-[1.5px_2px_0px_#1f2329] active:translate-y-[1px] transition-all';
          } else {
            btn.className = 'sort-tab-btn flex items-center gap-1 px-2.5 py-1 rounded-xl text-[11px] font-bold border-2 border-stone-800 bg-white text-stone-700 hover:bg-amber-50 shadow-[1.5px_2px_0px_#1f2329] active:translate-y-[1px] transition-all';
          }
        });
      }

      sortMostPlayedBtn?.addEventListener('click', () => {
        setSortActiveTab(sortMostPlayedBtn);
        const counts = getPlayCounts();
        const cards = Array.from(document.querySelectorAll('.game-card'));
        cards.sort((a, b) => {
          const sA = a.getAttribute('data-game-slug') || '';
          const sB = b.getAttribute('data-game-slug') || '';
          return (counts[sB] || 0) - (counts[sA] || 0);
        });
        cards.forEach((card) => sortContainer?.appendChild(card));
      });

      sortTopScoreBtn?.addEventListener('click', () => {
        setSortActiveTab(sortTopScoreBtn);
        const scores = getGameScores();
        const cards = Array.from(document.querySelectorAll('.game-card'));
        cards.sort((a, b) => {
          const sA = a.getAttribute('data-game-slug') || '';
          const sB = b.getAttribute('data-game-slug') || '';
          return (scores[sB] || 0) - (scores[sA] || 0);
        });
        cards.forEach((card) => sortContainer?.appendChild(card));
      });

      sortDefaultBtn?.addEventListener('click', () => {
        setSortActiveTab(sortDefaultBtn);
        const cards = Array.from(document.querySelectorAll('.game-card'));
        cards.sort((a, b) => {
          const oA = parseInt(a.getAttribute('data-initial-order') || '0', 10);
          const oB = parseInt(b.getAttribute('data-initial-order') || '0', 10);
          return oA - oB;
        });
        cards.forEach((card) => sortContainer?.appendChild(card));
      });

      // ==========================================
      // DETAILED PER-GAME RANK MODAL SYSTEM
      // ==========================================
      let currentSelectedGameSlug = 'punching';

      const tabBtnMinigameRank = document.getElementById('tab-btn-minigame-rank');
      const tabBtnMostPlayed = document.getElementById('tab-btn-most-played');
      const tabBtnGlobalRank = document.getElementById('tab-btn-global-rank');

      const rankViewMinigame = document.getElementById('rank-view-minigame');
      const rankViewMostPlayed = document.getElementById('rank-view-most-played');
      const rankViewGlobal = document.getElementById('rank-view-global');

      function switchRankTab(activeTab) {
        [tabBtnMinigameRank, tabBtnMostPlayed, tabBtnGlobalRank].forEach((btn) => {
          if (!btn) return;
          if (btn === activeTab) {
            btn.className = 'rank-nav-tab flex-1 py-1.5 px-1 rounded-lg text-center font-bold text-[11px] bg-white text-stone-900 shadow-xs border border-stone-800/20 active:translate-y-[0.5px] transition-all';
          } else {
            btn.className = 'rank-nav-tab flex-1 py-1.5 px-1 rounded-lg text-center font-bold text-[11px] text-stone-600 hover:text-stone-900 active:translate-y-[0.5px] transition-all';
          }
        });

        if (rankViewMinigame) rankViewMinigame.style.display = activeTab === tabBtnMinigameRank ? 'flex' : 'none';
        if (rankViewMostPlayed) rankViewMostPlayed.style.display = activeTab === tabBtnMostPlayed ? 'flex' : 'none';
        if (rankViewGlobal) rankViewGlobal.style.display = activeTab === tabBtnGlobalRank ? 'flex' : 'none';

        if (activeTab === tabBtnMostPlayed) {
          renderMostPlayedTabList();
        }
      }

      tabBtnMinigameRank?.addEventListener('click', () => switchRankTab(tabBtnMinigameRank));
      tabBtnMostPlayed?.addEventListener('click', () => switchRankTab(tabBtnMostPlayed));
      tabBtnGlobalRank?.addEventListener('click', () => switchRankTab(tabBtnGlobalRank));

      function renderSelectedGameRank(slug) {
        currentSelectedGameSlug = slug;
        const game = ALL_GAMES_INFO.find((g) => g.slug === slug) || ALL_GAMES_INFO[0];
        const scores = getGameScores();
        const counts = getPlayCounts();
        const myScore = scores[slug] || 0;
        const myPlays = counts[slug] || 0;
        const tier = getGameRankTier(slug, myScore);

        // Highlight picker item
        document.querySelectorAll('.minigame-picker-btn').forEach((btn) => {
          const btnSlug = btn.getAttribute('data-picker-slug');
          if (btnSlug === slug) {
            btn.className = 'minigame-picker-btn shrink-0 flex items-center gap-1.5 px-2.5 py-1 rounded-xl border-2 border-stone-900 text-[11px] font-bold shadow-xs bg-amber-300 text-stone-950';
            btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          } else {
            btn.className = 'minigame-picker-btn shrink-0 flex items-center gap-1.5 px-2 py-1 rounded-xl border border-stone-800 text-[11px] font-bold shadow-xs bg-white text-stone-700 hover:bg-stone-50';
          }
        });

        // Update card info
        const titleEl = document.getElementById('selected-game-title');
        const badgeEl = document.getElementById('selected-game-badge');
        const rankNameEl = document.getElementById('selected-game-rank-name');
        const scoreEl = document.getElementById('selected-game-score');
        const currTierEl = document.getElementById('selected-game-curr-tier-lbl');
        const nextTierEl = document.getElementById('selected-game-next-tier-lbl');
        const progressBarEl = document.getElementById('selected-game-progress-bar');
        const playsStatEl = document.getElementById('selected-game-plays-stat');
        const gcIdEl = document.getElementById('selected-game-gc-id');
        const lbGameNameEl = document.getElementById('leaderboard-game-name');

        if (titleEl) titleEl.textContent = game.name;
        if (badgeEl) badgeEl.textContent = tier.badge;
        if (rankNameEl) rankNameEl.textContent = `${tier.badge} ${tier.rankTitle}`;
        if (scoreEl) scoreEl.innerHTML = `${myScore} <span class='text-[10px] font-bold text-amber-800'>${game.unit}</span>`;
        if (currTierEl) currTierEl.textContent = tier.currTierLbl;
        if (nextTierEl) nextTierEl.textContent = tier.nextTierLbl;
        if (progressBarEl) progressBarEl.style.width = `${tier.progress}%`;
        if (playsStatEl) playsStatEl.textContent = `🕹️ Lượt chơi: ${myPlays} lần`;
        if (gcIdEl) gcIdEl.textContent = `ID: stickman_war_${slug}`;
        if (lbGameNameEl) lbGameNameEl.textContent = game.name;

        // Render Top 5 mock leaderboard for this game
        const topListEl = document.getElementById('selected-game-top-list');
        if (topListEl) {
          const mockTop = [
            { rank: '1 🥇', name: 'NinjaStick_Pro', score: Math.round(myScore * 1.8 + 25) },
            { rank: '2 🥈', name: 'ShadowFighter', score: Math.round(myScore * 1.4 + 15) },
            { rank: '3 🥉', name: 'DragonMaster', score: Math.round(myScore * 1.15 + 8) },
            { rank: '4 🎖️', name: `<span class="my-player-display-name">${getPlayerName()} (Bạn)</span>`, score: myScore, isMe: true },
            { rank: '5 🎖️', name: 'GoonHunter_VN', score: Math.max(0, Math.round(myScore * 0.85 - 5)) }
          ];
          topListEl.innerHTML = mockTop
            .map(
              (p) => `
            <div class='flex items-center justify-between py-1.5 ${p.isMe ? 'bg-amber-50/90 font-bold text-amber-950 px-1 rounded' : 'text-stone-700'}'>
              <div class='flex items-center gap-2'>
                <span class='w-6 text-center font-bold text-[10.5px]'>${p.rank}</span>
                <span>${p.name}</span>
              </div>
              <div class='font-black text-stone-900'>${p.score} <span class='text-[9.5px] font-semibold text-stone-500'>${game.unit}</span></div>
            </div>
          `
            )
            .join('');
        }
      }

      // Connect Minigame Picker Buttons in Tab 1
      document.querySelectorAll('.minigame-picker-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const slug = btn.getAttribute('data-picker-slug');
          if (slug) renderSelectedGameRank(slug);
        });
      });

      // Tab 1 Action Buttons
      const openSelectedGameGcBtn = document.getElementById('open-selected-game-gc-btn');
      const playSelectedGameDirectBtn = document.getElementById('play-selected-game-direct-btn');

      openSelectedGameGcBtn?.addEventListener('click', async () => {
        const gcLeaderboardId = 'stickman_war_' + currentSelectedGameSlug;
        try {
          if (window.Capacitor?.isNativePlatform?.()) {
            await GameCenter.showLeaderboard({ leaderboardID: gcLeaderboardId });
          } else {
            alert(`🏆 Apple Game Center: Đang mở Bảng Xếp Hạng riêng cho ${currentSelectedGameSlug} (${gcLeaderboardId})!`);
          }
        } catch (e) {
          alert(`🏆 Game Center: Leaderboard ${gcLeaderboardId} đã sẵn sàng!`);
        }
      });

      playSelectedGameDirectBtn?.addEventListener('click', () => {
        closeRankModal();
        openGame(currentSelectedGameSlug);
      });

      // Tab 2: Render Top 20 Most Played Minigames
      function renderMostPlayedTabList() {
        const container = document.getElementById('most-played-list-container');
        if (!container) return;

        const counts = getPlayCounts();
        const scores = getGameScores();
        const sortedGames = [...ALL_GAMES_INFO].sort((a, b) => (counts[b.slug] || 0) - (counts[a.slug] || 0));
        const maxPlays = Math.max(...sortedGames.map((g) => counts[g.slug] || 0), 1);

        container.innerHTML = sortedGames
          .map((g, idx) => {
            const plays = counts[g.slug] || 0;
            const pct = Math.min(100, Math.round((plays / maxPlays) * 100));
            const best = scores[g.slug] || 0;
            const tier = getGameRankTier(g.slug, best);

            let rankIcon = `#${idx + 1}`;
            if (idx === 0) rankIcon = '🥇 #1';
            else if (idx === 1) rankIcon = '🥈 #2';
            else if (idx === 2) rankIcon = '🥉 #3';

            return `
            <div class='flex items-center justify-between p-2 rounded-xl bg-white border border-stone-800/15 shadow-xs'>
              <div class='flex items-center gap-2 flex-1 min-w-0 pr-2'>
                <span class='w-7 text-center font-bold text-[11px] text-stone-800'>${rankIcon}</span>
                <img src='/thumbs/${g.slug}.webp' alt='' class='size-8 rounded-lg object-contain bg-neutral-100 border border-stone-200' />
                <div class='min-w-0 flex-1'>
                  <div class='flex items-center gap-1.5'>
                    <span class='font-bold text-[12.5px] text-stone-900 truncate'>${g.name}</span>
                    <span class='text-[10px] font-bold text-amber-900 bg-amber-100 px-1 py-0.2 rounded'>${tier.badge}</span>
                  </div>
                  <div class='flex items-center gap-2 mt-0.5'>
                    <span class='text-[10.5px] font-semibold text-rose-600'>🔥 ${formatCount(plays)} lượt</span>
                    <div class='w-16 h-1.5 bg-stone-100 rounded-full overflow-hidden'>
                      <div class='h-full bg-gradient-to-r from-amber-400 to-rose-500 rounded-full' style='width: ${pct}%'></div>
                    </div>
                  </div>
                </div>
              </div>
              <button
                type='button'
                class='play-now-from-list-btn shrink-0 px-2.5 py-1 rounded-lg bg-amber-300 hover:bg-amber-400 text-stone-900 font-bold text-[11px] border border-stone-800 shadow-xs active:translate-y-[0.5px]'
                data-play-slug='${g.slug}'
              >
                Chơi
              </button>
            </div>
          `;
          })
          .join('');

        // Connect play buttons in list
        container.querySelectorAll('.play-now-from-list-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const slug = btn.getAttribute('data-play-slug');
            if (slug) {
              closeRankModal();
              openGame(slug);
            }
          });
        });
      }

      // Connect Quick Rank button on each game card
      document.querySelectorAll('.game-quick-rank-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const slug = btn.getAttribute('data-rank-slug');
          if (slug) {
            openRankModal();
            switchRankTab(tabBtnMinigameRank);
            renderSelectedGameRank(slug);
          }
        });
      });

      let currentSlugActive = null;
      let scoreSyncInterval = null;

      function setupIframe() {
        try {
          const win = frame.contentWindow;
          const doc = frame.contentDocument || win?.document;
          if (!win || !doc) return;

          win.focus();

          // Tối ưu viewport chống zoom quá cỡ
          let meta = doc.querySelector('meta[name="viewport"]');
          if (meta) {
            meta.setAttribute('content', 'width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover');
          }

          // Chặn double-tap zoom trên WebKit
          doc.addEventListener('dblclick', (e) => e.preventDefault(), { passive: false });

          // Periodic score sync from inside the game iframe
          if (scoreSyncInterval) clearInterval(scoreSyncInterval);
          scoreSyncInterval = setInterval(() => {
            try {
              if (!currentSlugActive) return;
              const sEl = doc.getElementById('score');
              const bEl = doc.getElementById('best');
              const sVal = parseInt(sEl?.textContent || '0', 10);
              const bVal = parseInt(bEl?.textContent || '0', 10);
              const score = Math.max(isNaN(sVal) ? 0 : sVal, isNaN(bVal) ? 0 : bVal);
              if (score > 0) {
                saveGameScore(currentSlugActive, score);
              }
            } catch (err) {}
          }, 1200);

          // Kiểm soát ẩn/hiện nút Home góc trên
          function checkCardState() {
            try {
              const hasCard = !!(
                doc.querySelector('.card.show') ||
                doc.querySelector('#overlay.on') ||
                doc.querySelector('.modal.show') ||
                doc.querySelector('#startCard.show') ||
                doc.querySelector('#endCard.show')
              );
              setHomeButtonVisible(!hasCard);

              // When card shows (game over or end), sync score immediately
              if (hasCard && currentSlugActive) {
                const sEl = doc.getElementById('score');
                const bEl = doc.getElementById('best');
                const sVal = parseInt(sEl?.textContent || '0', 10);
                const bVal = parseInt(bEl?.textContent || '0', 10);
                const score = Math.max(isNaN(sVal) ? 0 : sVal, isNaN(bVal) ? 0 : bVal);
                if (score > 0) saveGameScore(currentSlugActive, score);
              }
            } catch (e) {}
          }

          try {
            const obs = new win.MutationObserver(checkCardState);
            obs.observe(doc.body, { attributes: true, subtree: true, attributeFilter: ['class', 'style'] });
            checkCardState();
            setTimeout(checkCardState, 200);
          } catch (e) {}

          // Bắt sự kiện thoát game
          doc.addEventListener('click', (ev) => {
            const a = ev.target.closest('a');
            if (a) {
              const href = a.getAttribute('href');
              if (href === '/' || href === '/all' || href === 'index.html' || a.classList.contains('back') || a.classList.contains('exit')) {
                ev.preventDefault();
                ev.stopPropagation();
                closeGame();
                return;
              }
              // Chặn điều hướng trực tiếp sang file ảnh blob
              if (a.href && (a.href.startsWith('blob:') || a.download)) {
                ev.preventDefault();
                ev.stopPropagation();
                openScorecard(a.href, a.download || 'stickerman-score.png');
                return;
              }
            }
          }, true);

          // Bắt lệnh click tải ảnh từ code js của game
          const origClick = win.HTMLAnchorElement.prototype.click;
          win.HTMLAnchorElement.prototype.click = function() {
            if (this.href && (this.href.startsWith('blob:') || this.download)) {
              openScorecard(this.href, this.download || 'stickerman-score.png');
              return;
            }
            return origClick.apply(this, arguments);
          };
        } catch (err) {
          console.warn('Iframe setup error', err);
        }
      }

      function openGame(slug) {
        if (!modal || !frame) return;
        currentSlugActive = slug;
        incrementGamePlay(slug);
        frame.src = `/games/${slug}.html`;
        modal.style.display = 'block';
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        setHomeButtonVisible(false);

        frame.onload = setupIframe;
      }

      function closeGame() {
        if (scoreSyncInterval) {
          clearInterval(scoreSyncInterval);
          scoreSyncInterval = null;
        }
        currentSlugActive = null;
        if (!modal || !frame) return;
        frame.src = 'about:blank';
        modal.style.display = 'none';
        modal.classList.add('hidden');
        document.body.style.overflow = '';
        closeScorecard();
        updateHomepageCardsUI();
      }

      // Also listen for popstate or messages
      window.addEventListener('message', (ev) => {
        if (ev.data === 'close-game' || ev.data?.type === 'close-game') closeGame();
        if (ev.data?.type === 'show-scorecard') openScorecard(ev.data.url, ev.data.filename);
        if (ev.data?.type === 'set_home_btn') setHomeButtonVisible(ev.data.visible);
      });

      document.querySelectorAll('[data-game-slug]').forEach((card) => {
        card.addEventListener('click', (e) => {
          e.preventDefault();
          const slug = card.getAttribute('data-game-slug');
          if (slug) {
            openGame(slug);
          }
        });
      });

      // Quick Action Buttons
      const allCards = Array.from(document.querySelectorAll('[data-game-slug]'));
      const quickBtn = document.getElementById('quick-play-btn');
      const topPickBtn = document.getElementById('top-pick-btn');

      quickBtn?.addEventListener('click', () => {
        if (allCards.length > 0) {
          const randomCard = allCards[Math.floor(Math.random() * allCards.length)];
          const slug = randomCard.getAttribute('data-game-slug');
          if (slug) openGame(slug);
        }
      });

      topPickBtn?.addEventListener('click', () => {
        openGame('punching');
      });

      // ==========================================
      // SMART NOTIFICATION, SETTINGS & GAME CENTER
      // ==========================================

      // 1. Modals & Controls Elements
      const notifBtn = document.getElementById('notif-bell-btn');
      const notifModal = document.getElementById('notif-modal');
      const notifCloseBtn = document.getElementById('notif-close-btn');
      const notifBadge = document.getElementById('notif-badge-counter');
      const notifMarkAllBtn = document.getElementById('notif-mark-all-read-btn');
      const notifClaimBtn = document.getElementById('notif-claim-btn');
      const notifPlayQuestBtn = document.getElementById('notif-play-quest-btn');
      const notifViewRankBtn = document.getElementById('notif-view-rank-btn');
      const smartReminderToggle = document.getElementById('smart-reminder-toggle');

      const settingsBtn = document.getElementById('settings-btn');
      const settingsModal = document.getElementById('settings-modal');
      const settingsCloseBtn = document.getElementById('settings-close-btn');
      const settingSfxToggle = document.getElementById('setting-sfx-toggle');
      const settingHapticToggle = document.getElementById('setting-haptic-toggle');
      const settingsOpenGcBtn = document.getElementById('settings-open-gc-btn');
      const settingsResetDataBtn = document.getElementById('settings-reset-data-btn');

      const rankBtn = document.getElementById('rank-btn');
      const rankModal = document.getElementById('rank-modal');
      const rankCloseBtn = document.getElementById('rank-close-btn');
      const openAppleGcBtn = document.getElementById('open-apple-gc-native-btn');

      const rankPlayerBadge = document.getElementById('rank-player-badge');
      const rankPlayerTitle = document.getElementById('rank-player-title');
      const rankPlayerAlias = document.getElementById('rank-player-alias');
      const rankTotalPoints = document.getElementById('rank-total-points');
      const rankCurrTierLabel = document.getElementById('rank-curr-tier-label');
      const rankNextTierLabel = document.getElementById('rank-next-tier-label');
      const rankProgressBar = document.getElementById('rank-progress-bar');

      // 2. Rank & Points State Management
      function getWarPoints() {
        return parseInt(localStorage.getItem('stickman_war_points') || '180', 10);
      }

      function updateRankUI() {
        const points = getWarPoints();
        let badge = '🥉';
        let title = 'Tân Binh Đồng';
        let currTier = 'Đồng (0 WP)';
        let nextTier = 'Mục tiêu: Bạc (100 WP)';
        let progress = 0;

        if (points < 100) {
          badge = '🥉';
          title = 'Tân Binh Đồng';
          currTier = 'Đồng (0 WP)';
          nextTier = 'Mục tiêu: Bạc (100 WP)';
          progress = Math.min(100, Math.round((points / 100) * 100));
        } else if (points < 250) {
          badge = '🥈';
          title = 'Chiến Binh Bạc';
          currTier = 'Bạc (100 WP)';
          nextTier = 'Mục tiêu: Vàng (250 WP)';
          progress = Math.min(100, Math.round(((points - 100) / 150) * 100));
        } else if (points < 500) {
          badge = '🥇';
          title = 'Đấu Sĩ Vàng';
          currTier = 'Vàng (250 WP)';
          nextTier = 'Mục tiêu: Kim Cương (500 WP)';
          progress = Math.min(100, Math.round(((points - 250) / 250) * 100));
        } else if (points < 1000) {
          badge = '💎';
          title = 'Bậc Thầy Kim Cương';
          currTier = 'Kim Cương (500 WP)';
          nextTier = 'Mục tiêu: Chiến Thần (1000 WP)';
          progress = Math.min(100, Math.round(((points - 500) / 500) * 100));
        } else {
          badge = '👑';
          title = 'Chiến Thần Stickman';
          currTier = 'Chiến Thần (>1000 WP)';
          nextTier = 'Cấp Bậc Tối Cao 🏆';
          progress = 100;
        }

        if (rankPlayerBadge) rankPlayerBadge.textContent = badge;
        if (rankPlayerTitle) rankPlayerTitle.textContent = title;
        if (rankTotalPoints) rankTotalPoints.innerHTML = `${points} <span class='text-[10px] font-bold text-amber-800'>WP</span>`;
        if (rankCurrTierLabel) rankCurrTierLabel.textContent = currTier;
        if (rankNextTierLabel) rankNextTierLabel.textContent = nextTier;
        if (rankProgressBar) rankProgressBar.style.width = `${progress}%`;
      }

      // 3. Apple Game Center Bridge & Player Identity
      const GameCenter = window.Capacitor?.registerPlugin?.('GameCenter') || window.Capacitor?.Plugins?.GameCenter || {
        authenticate: async () => ({ authenticated: true, alias: ' Huy Lộc Phát ' }),
        showLeaderboard: async () => ({ success: true }),
        submitScore: async (opts) => ({ submitted: true, score: opts?.score || 0 }),
        getPlayerProfile: async () => ({ authenticated: true, alias: ' Huy Lộc Phát ' })
      };

      function getPlayerName() {
        return localStorage.getItem('stickman_gc_alias') || localStorage.getItem('stickman_player_name') || ' Huy Lộc Phát ';
      }

      function updatePlayerUI(alias, isAuthenticated) {
        const points = getWarPoints();
        const topBarName = document.getElementById('top-bar-player-name');
        const topBarStatus = document.getElementById('top-bar-player-status');
        const topBarTier = document.getElementById('top-bar-player-tier');
        const rankAlias = document.getElementById('rank-player-alias');
        const settingsStatus = document.getElementById('settings-gc-status');
        const settingsPlayerDisplay = document.getElementById('settings-player-name-display');

        let tierShort = '🥉 Đồng';
        if (points >= 1000) tierShort = '👑 Thần';
        else if (points >= 500) tierShort = '💎 KC';
        else if (points >= 250) tierShort = '🥇 Vàng';
        else if (points >= 100) tierShort = '🥈 Bạc';

        if (topBarName) topBarName.textContent = alias || ' Huy Lộc Phát ';
        if (topBarTier) topBarTier.textContent = tierShort;
        if (topBarStatus) {
          topBarStatus.className = isAuthenticated
            ? 'size-2 rounded-full bg-emerald-500 shadow-xs'
            : 'size-2 rounded-full bg-amber-400';
        }
        if (rankAlias) {
          rankAlias.textContent = isAuthenticated ? `Game Center: ${alias}` : `Chiến binh: ${alias}`;
        }
        if (settingsStatus) {
          settingsStatus.textContent = isAuthenticated ? `🟢 Đã kết nối: ${alias}` : `🔴 Chạm để kết nối Game Center`;
        }
        if (settingsPlayerDisplay) {
          settingsPlayerDisplay.textContent = alias || ' Huy Lộc Phát ';
        }

        // Update in rank modal tables if open
        const myNameInTables = document.querySelectorAll('.my-player-display-name');
        myNameInTables.forEach((el) => {
          el.textContent = `${alias} (Bạn)`;
        });
      }

      async function initGameCenter() {
        const initialName = getPlayerName();
        updatePlayerUI(initialName, false);

        try {
          // Tự động kích hoạt đăng nhập Game Center ngay khi mở app
          const authRes = await GameCenter.authenticate();
          if (authRes?.authenticated && authRes?.alias) {
            localStorage.setItem('stickman_gc_alias', authRes.alias);
            updatePlayerUI(authRes.alias, true);
            
            // Tự động đồng bộ điểm số tích lũy lên Game Center Leaderboard
            const points = getWarPoints();
            await GameCenter.submitScore({ score: points, leaderboardID: 'stickman_war_leaderboard' });
          } else {
            const profile = await GameCenter.getPlayerProfile();
            if (profile?.authenticated && profile?.alias) {
              localStorage.setItem('stickman_gc_alias', profile.alias);
              updatePlayerUI(profile.alias, true);
            } else if (profile?.alias) {
              updatePlayerUI(profile.alias, false);
            }
          }
        } catch (e) {
          console.log('[GameCenter] Auto-login notice', e);
        }
      }
      initGameCenter();

      // Tap top profile bar to open Rank modal
      const headerProfileSec = document.getElementById('header-profile-section');
      headerProfileSec?.addEventListener('click', () => {
        openRankModal();
      });

      // Settings Edit Name Button
      const editNameBtn = document.getElementById('settings-edit-name-btn');
      editNameBtn?.addEventListener('click', () => {
        const current = getPlayerName();
        const newName = prompt('Nhập tên người chơi Stickman của bạn:', current);
        if (newName && newName.trim()) {
          const trimmed = newName.trim();
          localStorage.setItem('stickman_player_name', trimmed);
          localStorage.setItem('stickman_gc_alias', trimmed);
          updatePlayerUI(trimmed, true);
          renderSelectedGameRank(currentSelectedGameSlug);
          alert('✓ Đã cập nhật tên người chơi: ' + trimmed);
        }
      });

      async function triggerOpenGameCenter() {
        try {
          if (window.Capacitor?.isNativePlatform?.()) {
            await GameCenter.showLeaderboard({ leaderboardID: 'stickman_war_leaderboard' });
          } else {
            alert('🏆 Apple Game Center: Đã đồng bộ điểm số ' + getWarPoints() + ' WP lên Bảng Xếp Hạng Game Center!');
          }
        } catch (err) {
          alert('🏆 Game Center: Điểm ' + getWarPoints() + ' WP đã sẵn sàng đồng bộ!');
        }
      }

      openAppleGcBtn?.addEventListener('click', triggerOpenGameCenter);
      settingsOpenGcBtn?.addEventListener('click', () => {
        closeSettingsModal();
        openRankModal();
      });

      // 4. Modal Open/Close Controls
      function openNotifModal() {
        if (notifModal) {
          notifModal.style.display = 'flex';
          notifModal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
      }

      function closeNotifModal() {
        if (notifModal) {
          notifModal.style.display = 'none';
          notifModal.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      function openSettingsModal() {
        if (settingsModal) {
          settingsModal.style.display = 'flex';
          settingsModal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
      }

      function closeSettingsModal() {
        if (settingsModal) {
          settingsModal.style.display = 'none';
          settingsModal.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      function openRankModal() {
        updateRankUI();
        if (rankModal) {
          rankModal.style.display = 'flex';
          rankModal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
      }

      function closeRankModal() {
        if (rankModal) {
          rankModal.style.display = 'none';
          rankModal.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      // Connect Header Buttons
      notifBtn?.addEventListener('click', openNotifModal);
      notifCloseBtn?.addEventListener('click', closeNotifModal);
      notifModal?.addEventListener('click', (e) => {
        if (e.target === notifModal) closeNotifModal();
      });

      settingsBtn?.addEventListener('click', openSettingsModal);
      settingsCloseBtn?.addEventListener('click', closeSettingsModal);
      settingsModal?.addEventListener('click', (e) => {
        if (e.target === settingsModal) closeSettingsModal();
      });

      rankBtn?.addEventListener('click', openRankModal);
      rankCloseBtn?.addEventListener('click', closeRankModal);
      rankModal?.addEventListener('click', (e) => {
        if (e.target === rankModal) closeRankModal();
      });

      // 5. Smart Notifications Actions
      const isClaimed = localStorage.getItem('stickman_daily_claimed') === 'true';
      if (isClaimed && notifClaimBtn) {
        notifClaimBtn.disabled = true;
        notifClaimBtn.innerHTML = '<span>✓ Đã Nhận</span>';
        notifClaimBtn.className = 'flex items-center gap-1 px-2.5 py-1 rounded-lg bg-stone-200 text-stone-500 text-[11px] font-semibold border border-stone-300 cursor-default';
      }

      notifClaimBtn?.addEventListener('click', () => {
        if (localStorage.getItem('stickman_daily_claimed') === 'true') return;
        localStorage.setItem('stickman_daily_claimed', 'true');
        const newPoints = getWarPoints() + 50;
        localStorage.setItem('stickman_war_points', newPoints.toString());
        updateRankUI();

        // Update button
        notifClaimBtn.disabled = true;
        notifClaimBtn.innerHTML = '<span>✓ Đã Nhận +50 WP!</span>';
        notifClaimBtn.className = 'flex items-center gap-1 px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 text-[11px] font-bold border border-emerald-300 cursor-default';

        // Decrement badge
        if (notifBadge && notifBadge.style.display !== 'none') {
          const count = parseInt(notifBadge.textContent || '1', 10) - 1;
          if (count <= 0) {
            notifBadge.style.display = 'none';
          } else {
            notifBadge.textContent = count.toString();
          }
        }
      });

      notifPlayQuestBtn?.addEventListener('click', () => {
        closeNotifModal();
        openGame('punching');
      });

      notifViewRankBtn?.addEventListener('click', () => {
        closeNotifModal();
        openRankModal();
      });

      notifMarkAllBtn?.addEventListener('click', () => {
        if (notifBadge) notifBadge.style.display = 'none';
        localStorage.setItem('stickman_notif_all_read', 'true');
      });

      if (localStorage.getItem('stickman_notif_all_read') === 'true' && notifBadge) {
        notifBadge.style.display = 'none';
      }

      // 6. Settings Persistence
      if (settingSfxToggle) {
        settingSfxToggle.checked = localStorage.getItem('stickman_sfx') !== 'false';
        settingSfxToggle.addEventListener('change', () => {
          localStorage.setItem('stickman_sfx', settingSfxToggle.checked ? 'true' : 'false');
        });
      }

      if (settingHapticToggle) {
        settingHapticToggle.checked = localStorage.getItem('stickman_haptic') !== 'false';
        settingHapticToggle.addEventListener('change', () => {
          localStorage.setItem('stickman_haptic', settingHapticToggle.checked ? 'true' : 'false');
        });
      }

      if (smartReminderToggle) {
        smartReminderToggle.checked = localStorage.getItem('stickman_smart_remind') !== 'false';
        smartReminderToggle.addEventListener('change', () => {
          localStorage.setItem('stickman_smart_remind', smartReminderToggle.checked ? 'true' : 'false');
          if (smartReminderToggle.checked && 'Notification' in window && Notification.permission !== 'granted') {
            Notification.requestPermission();
          }
        });
      }

      settingsResetDataBtn?.addEventListener('click', () => {
        if (confirm('Bạn có chắc chắn muốn đặt lại điểm Rank và dữ liệu trò chơi không?')) {
          localStorage.removeItem('stickman_war_points');
          localStorage.removeItem('stickman_daily_claimed');
          localStorage.removeItem('stickman_notif_all_read');
          updateRankUI();
          if (notifBadge) {
            notifBadge.style.display = 'flex';
            notifBadge.textContent = '3';
          }
          alert('✓ Đã khôi phục dữ liệu ban đầu thành công!');
        }
      });

      // Initial Rank & Homepage Cards Setup
      updateRankUI();
      updateHomepageCardsUI();
      renderSelectedGameRank('punching');

      // ==========================================
      // 7. VIP 7-DAY FREE TRIAL & STORE SYSTEM ($4.99)
      // ==========================================
      const topBarVipBadge = document.getElementById('top-bar-vip-badge');
      const topBarVipText = document.getElementById('top-bar-vip-text');
      const settingsVipCountdown = document.getElementById('settings-vip-trial-countdown');
      const settingsOpenStoreBtn = document.getElementById('settings-open-store-btn');

      const vipStoreModal = document.getElementById('vip-store-modal');
      const vipStoreCloseBtn = document.getElementById('vip-store-close-btn');
      const modalVipCountdownTimer = document.getElementById('modal-vip-countdown-timer');
      const buyAllAccessBtn = document.getElementById('buy-all-access-btn');
      const vipGamesList = document.getElementById('vip-games-list');
      const vipRestoreBtn = document.getElementById('vip-restore-btn');

      const vipToast = document.getElementById('vip-toast');
      const vipToastIcon = document.getElementById('vip-toast-icon');
      const vipToastMsg = document.getElementById('vip-toast-msg');
      let vipToastTimeout = null;

      function showVIPToast(msg, icon = '🎉') {
        if (!vipToast) return;
        if (vipToastTimeout) clearTimeout(vipToastTimeout);
        if (vipToastIcon) vipToastIcon.textContent = icon;
        if (vipToastMsg) vipToastMsg.textContent = msg;
        vipToast.style.display = 'flex';
        vipToast.classList.remove('hidden');
        vipToastTimeout = setTimeout(() => {
          vipToast.style.display = 'none';
          vipToast.classList.add('hidden');
        }, 3200);
      }

      function getVIPTrialData() {
        let start = localStorage.getItem('stickman_vip_trial_start');
        if (!start) {
          start = Date.now().toString();
          localStorage.setItem('stickman_vip_trial_start', start);
        }
        const startTime = parseInt(start, 10);
        const now = Date.now();
        const totalTrial = 7 * 24 * 60 * 60 * 1000;
        const remaining = Math.max(0, totalTrial - (now - startTime));
        const isActive = remaining > 0;

        const days = Math.floor(remaining / (24 * 60 * 60 * 1000));
        const hours = Math.floor((remaining % (24 * 60 * 60 * 1000)) / (60 * 60 * 1000));
        const minutes = Math.floor((remaining % (60 * 60 * 1000)) / (60 * 1000));

        let unlockedGames = {};
        try {
          unlockedGames = JSON.parse(localStorage.getItem('stickman_unlocked_games') || '{}');
        } catch (e) {}
        const isAllUnlocked = localStorage.getItem('stickman_all_unlocked') === 'true';

        return {
          isActive,
          remainingMs: remaining,
          days,
          hours,
          minutes,
          timeStr: days > 0 ? `${days} ngày ${hours}h` : `${hours}h ${minutes}p`,
          fullTimeStr: `⏳ Còn ${days} ngày ${hours} giờ ${minutes}p`,
          unlockedGames,
          isAllUnlocked
        };
      }

      function updateVIPStatusUI() {
        const vip = getVIPTrialData();
        if (vip.isAllUnlocked) {
          if (topBarVipText) topBarVipText.textContent = 'VIP Vĩnh Viễn';
          if (settingsVipCountdown) settingsVipCountdown.textContent = '👑 Đã mở khóa All-Access trọn đời';
          if (modalVipCountdownTimer) modalVipCountdownTimer.textContent = '👑 Vĩnh Viễn (All-Access)';
        } else if (vip.isActive) {
          if (topBarVipText) topBarVipText.textContent = `VIP Free (${vip.days > 0 ? vip.days + ' ngày' : vip.hours + 'h'})`;
          if (settingsVipCountdown) settingsVipCountdown.textContent = `⏳ Đang kích hoạt · Còn ${vip.timeStr}`;
          if (modalVipCountdownTimer) modalVipCountdownTimer.textContent = vip.fullTimeStr;
        } else {
          if (topBarVipText) topBarVipText.textContent = 'Mua VIP';
          if (settingsVipCountdown) settingsVipCountdown.textContent = '⚠️ Hết hạn dùng thử · Mua Remove Ads';
          if (modalVipCountdownTimer) modalVipCountdownTimer.textContent = 'Đã hết hạn 7 ngày free';
        }

        renderVIPGamesList();
      }

      function renderVIPGamesList() {
        if (!vipGamesList) return;
        const vip = getVIPTrialData();

        vipGamesList.innerHTML = ALL_GAMES_INFO.map((game) => {
          const isUnlocked = vip.isAllUnlocked || vip.unlockedGames[game.slug] === true;

          return `
            <div class='flex items-center justify-between p-2 rounded-xl bg-white border border-stone-200 shadow-2xs'>
              <div class='flex items-center gap-2'>
                <div class='size-8 rounded-lg overflow-hidden border border-stone-200 bg-stone-50 shrink-0 flex items-center justify-center'>
                  <img src='/thumbs/${game.slug}.webp' alt='' class='size-7 object-contain' />
                </div>
                <div>
                  <div class='text-[12px] font-bold text-stone-900 leading-tight'>${game.name}</div>
                  <div class='text-[9.5px] text-stone-500 leading-tight'>${isUnlocked ? '✓ Sạch quảng cáo trọn đời' : vip.isActive ? 'Miễn phí trong 7 ngày' : 'Gói Remove Ads'}</div>
                </div>
              </div>
              <div>
                ${
                  isUnlocked
                    ? `<span class='px-2 py-1 rounded-lg bg-emerald-100 text-emerald-800 text-[10.5px] font-bold border border-emerald-300'>Đã Mua ✓</span>`
                    : `<button type='button' class='buy-single-game-btn px-2.5 py-1 rounded-lg bg-stone-900 hover:bg-stone-800 text-amber-300 font-bold text-[11px] border border-stone-800 shadow-xs active:scale-95 transition-transform' data-game-slug='${game.slug}' data-game-name='${game.name}'>
                        Mua $4.99
                      </button>`
                }
              </div>
            </div>
          `;
        }).join('');

        // Attach listeners for single game buy buttons
        vipGamesList.querySelectorAll('.buy-single-game-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const slug = btn.getAttribute('data-game-slug');
            const name = btn.getAttribute('data-game-name');
            if (!slug) return;

            const vipData = getVIPTrialData();
            vipData.unlockedGames[slug] = true;
            localStorage.setItem('stickman_unlocked_games', JSON.stringify(vipData.unlockedGames));

            showVIPToast(`✓ Đã mở khóa Remove Ads cho ${name}! ($4.99)`);
            updateVIPStatusUI();
          });
        });
      }

      function openVIPStoreModal() {
        updateVIPStatusUI();
        if (vipStoreModal) {
          vipStoreModal.style.display = 'flex';
          vipStoreModal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
      }

      function closeVIPStoreModal() {
        if (vipStoreModal) {
          vipStoreModal.style.display = 'none';
          vipStoreModal.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      topBarVipBadge?.addEventListener('click', openVIPStoreModal);
      settingsOpenStoreBtn?.addEventListener('click', () => {
        closeSettingsModal();
        openVIPStoreModal();
      });
      vipStoreCloseBtn?.addEventListener('click', closeVIPStoreModal);
      vipStoreModal?.addEventListener('click', (e) => {
        if (e.target === vipStoreModal) closeVIPStoreModal();
      });

      buyAllAccessBtn?.addEventListener('click', () => {
        localStorage.setItem('stickman_all_unlocked', 'true');
        showVIPToast('👑 Chúc mừng! Bạn đã sở hữu Gói All-Access VIP ($9.99)!', '👑');
        updateVIPStatusUI();
      });

      vipRestoreBtn?.addEventListener('click', () => {
        showVIPToast('✓ Đã khôi phục các giao dịch từ Apple ID của bạn thành công!', '🔄');
        updateVIPStatusUI();
      });

      // Initial VIP Status setup
      updateVIPStatusUI();
      if (window.location.hash === '#store') {
        openVIPStoreModal();
      }
    }
  </script>
</Base>
