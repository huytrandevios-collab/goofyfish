---
import GithubIcon from '~/components/GithubIcon.astro';
import Logo from '~/components/Logo.astro';
import StickmanHero from '~/components/StickmanHero.astro';
import Base from '~/layouts/Base.astro';
import { games } from '~/lib/games';
import { absoluteUrl, SITE } from '~/lib/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: SITE.name,
  itemListElement: games.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: absoluteUrl(`/${g.slug}`),
    name: g.name,
  })),
};
---

<Base title={`${SITE.name} · ${SITE.tagline}`} description={SITE.description} path='/' jsonLd={jsonLd}>
  <!-- Top App Bar: Stickman War & Notification Bell (Locked / Sticky at top by default) -->
  <header class='sticky top-0 z-30 w-full bg-[#f7f7f5]/95 backdrop-blur-md border-b border-stone-800/10 shadow-[0_1px_4px_rgba(0,0,0,0.04)]'>
    <nav class='mx-auto max-w-[1120px] px-4 pt-[calc(env(safe-area-inset-top,0px)+0.2rem)] pb-1.5 flex items-center justify-between sm:px-8'>
      <div class='flex items-center gap-2.5'>
        <!-- Official Stickman War App Icon with Comic Border -->
        <div class='relative flex size-9.5 shrink-0 items-center justify-center overflow-hidden rounded-xl border-2 border-stone-800 shadow-[2px_2.5px_0px_#1f2329]' style='border-radius: 11px 13px 10px 12px / 13px 11px 12px 10px;'>
          <img src="/favicon-192.png" alt="Stickman War Icon" class="size-full object-cover" />
        </div>
        <div>
          <h1 class='font-display text-[20px] font-bold tracking-tight text-stone-900 sm:text-[23px] leading-none'>
            Stickman War
          </h1>
          <p class='text-[11px] font-medium text-amber-900/80 leading-tight mt-0.5'>
            Arcade Battle Edition
          </p>
        </div>
      </div>

      <!-- Notification Bell Button with Comic Doodle Border -->
      <button
        id='notif-bell-btn'
        type='button'
        aria-label='Thông báo'
        class='group relative flex size-10 items-center justify-center rounded-xl border-2 border-stone-800 bg-white transition-all hover:bg-amber-50 active:translate-x-[1px] active:translate-y-[1px] shadow-[2.5px_3px_0px_#1f2329]'
        style='border-radius: 12px 14px 11px 13px / 14px 12px 13px 11px;'
      >
        <svg viewBox="0 0 24 24" class="size-5 text-stone-800 transition-transform group-hover:rotate-12 group-active:scale-90" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
        </svg>
        <!-- Active Notification Dot -->
        <span class='absolute top-1.5 right-1.5 flex size-2.5'>
          <span class='absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75'></span>
          <span class='relative inline-flex size-2.5 rounded-full border border-stone-900 bg-amber-500'></span>
        </span>
      </button>
    </nav>
  </header>

  <main class='mx-auto max-w-[1120px] px-4 pt-1 pb-[calc(env(safe-area-inset-bottom,0px)+0.25rem)] sm:px-8 sm:pt-2'>
    <section class='grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4'>
      <header
        class='col-span-2 flex flex-col justify-center rounded-2xl border-2 border-stone-800 bg-butter-soft p-3 sm:p-5 shadow-[3.5px_4px_0px_#1f2329]'
        style='border-radius: 20px 24px 22px 26px / 24px 20px 26px 22px;'
      >
        <StickmanHero />
      </header>

      <!-- Games Section Header -->
      <div class='col-span-2 flex items-center justify-between px-1 pt-1.5 pb-0.5'>
        <h2 class='font-display text-[15.5px] font-bold text-stone-900 tracking-tight flex items-center gap-1.5'>
          <span>🎮</span>
          <span>Chọn Trò Chơi</span>
        </h2>
        <span class='text-[11px] font-bold text-amber-950 bg-amber-100/90 border border-amber-900/20 px-2.5 py-0.5 rounded-full shadow-[1px_1px_0px_#1f2329]'>
          20 Thử Thách
        </span>
      </div>

      {
        games.map((game) => (
          <a
            href={`/${game.slug}`}
            data-game-slug={game.slug}
            data-game-name={game.name}
            class='group relative flex flex-col rounded-2xl border-2 border-stone-800/90 bg-white p-2 transition-all hover:-translate-y-0.5 active:translate-x-[1px] active:translate-y-[1px] shadow-[3px_3.5px_0px_#1f2329]'
            style='border-radius: 18px 22px 19px 23px / 22px 18px 23px 19px;'
          >
            <div class='relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-xl bg-neutral-50/60 border border-stone-200/80'>
              <img src={`/thumbs/${game.slug}.webp`} alt='' loading='lazy' class='h-[78%] w-[84%] object-contain' />
            </div>
            <div class='px-2 pt-3 pb-2'>
              <h2 class='font-display text-[17px] leading-tight sm:text-[18px] text-stone-900'>{game.name}</h2>
              <p class='mt-1 text-[13px] leading-snug text-neutral-600'>{game.tagline}</p>
            </div>
          </a>
        ))
      }
    </section>

    <footer class='mt-3 pb-1 flex flex-col items-center text-center'>
      <p class='text-[12px] font-medium leading-tight text-stone-600'>Copyright © Huy Tran</p>
      <p class='mt-0.5 text-[10.5px] leading-tight text-stone-400'>Stickman War Arcade · All rights reserved</p>
    </footer>
  </main>

  <!-- Full-screen In-App Game Player for Mobile -->
  <div id='game-modal' class='fixed inset-0 z-50 hidden bg-white' style='position: fixed; inset: 0; z-index: 9999; display: none;'>
    <iframe
      id='modal-game-frame'
      title='Game View'
      allow='camera; microphone; fullscreen; autoplay; web-share; clipboard-write'
      class='w-full h-full border-0 block bg-white'
    ></iframe>

    <!-- Nút Về Trang Chủ đặt SAU iframe để luôn nằm trên cùng (z-index 99999) -->
    <button
      id='modal-close-btn'
      type='button'
      aria-label='Về trang chủ'
      onclick='window.closeGame ? window.closeGame() : (document.getElementById("game-modal").style.display = "none")'
      style='position: fixed; top: calc(env(safe-area-inset-top, 0px) + 10px); right: 16px; z-index: 99999; pointer-events: auto;'
      class='flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-stone-900/90 active:scale-90 text-white text-[12.5px] font-semibold shadow-2xl backdrop-blur-md border border-white/30 cursor-pointer select-none'
    >
      <svg class='w-3.5 h-3.5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'>
        <path d='M18 6 6 18M6 6l12 12'/>
      </svg>
      <span>Trang chủ</span>
    </button>
  </div>

  <!-- Scorecard Preview Modal: Hiển thị Báo Cáo Kết Quả & Tranh Minh Họa chuẩn tỉ lệ di động -->
  <div
    id='scorecard-modal'
    class='fixed inset-0 z-[100000] hidden items-center justify-center p-3 bg-black/85 backdrop-blur-md transition-opacity select-none'
    style='display: none; position: fixed; inset: 0; z-index: 100000;'
  >
    <div class='relative max-w-sm w-full flex flex-col items-center animate-in fade-in zoom-in-95 duration-200'>
      <!-- Header -->
      <div class='flex items-center justify-between w-full px-2 mb-2 text-white'>
        <div class='flex items-center gap-2'>
          <span class='text-lg'>🏆</span>
          <div>
            <h3 class='text-[15px] font-bold text-amber-300 leading-tight'>Báo Cáo Thành Tích</h3>
            <p class='text-[11px] text-stone-300 leading-tight'>Tranh minh họa ván đấu của bạn</p>
          </div>
        </div>
        <button
          id='scorecard-top-close-btn'
          type='button'
          class='w-8 h-8 flex items-center justify-center rounded-full bg-white/20 hover:bg-white/30 text-white text-base active:scale-90 cursor-pointer transition-transform'
        >
          ✕
        </button>
      </div>

      <!-- Ảnh kết quả minh họa hiển thị trọn vẹn, co giãn theo chiều cao điện thoại với viền vẽ tay -->
      <div class='relative flex items-center justify-center w-full max-h-[66vh] overflow-hidden rounded-2xl bg-[#f7f7f5] shadow-[4px_5px_0px_#1f2329] border-2 border-stone-800' style='border-radius: 20px 24px 22px 26px / 24px 20px 26px 22px;'>
        <img
          id='scorecard-img'
          alt='Báo Cáo Minh Họa Sticker Man'
          class='w-auto max-h-[66vh] max-w-[88vw] object-contain block'
        />
      </div>

      <!-- Nút thao tác Lưu ảnh / Chia sẻ mạng xã hội / Đóng phong cách vẽ tay -->
      <div class='mt-3 flex w-full max-w-[88vw] gap-2'>
        <button
          id='scorecard-share-btn'
          type='button'
          class='flex-1 flex items-center justify-center gap-1.5 py-3 px-3 rounded-xl bg-amber-300 hover:bg-amber-200 active:translate-x-[1px] active:translate-y-[1px] text-stone-900 font-bold text-[13.5px] border-2 border-stone-800 shadow-[2.5px_3px_0px_#1f2329] transition-transform cursor-pointer'
          style='border-radius: 14px 16px 13px 15px / 15px 13px 16px 14px;'
        >
          <!-- Share Icon -->
          <svg class='w-4.5 h-4.5 shrink-0' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.3' stroke-linecap='round' stroke-linejoin='round'>
            <path d='M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8'/>
            <polyline points='16 6 12 2 8 6'/>
            <line x1='12' y1='2' x2='12' y2='15'/>
          </svg>
          <span class='truncate'>Chia sẻ MXH</span>
        </button>

        <button
          id='scorecard-save-btn'
          type='button'
          class='flex items-center justify-center gap-1.5 py-3 px-3 rounded-xl bg-white hover:bg-stone-50 active:translate-x-[1px] active:translate-y-[1px] text-stone-900 font-bold text-[13.5px] border-2 border-stone-800 shadow-[2.5px_3px_0px_#1f2329] transition-transform cursor-pointer'
          style='border-radius: 14px 16px 13px 15px / 15px 13px 16px 14px;'
        >
          <!-- Download Icon -->
          <svg class='w-4.5 h-4.5 shrink-0' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.3' stroke-linecap='round' stroke-linejoin='round'>
            <path d='M12 3v12'/>
            <path d='m7 10 5 5 5-5'/>
            <path d='M5 21h14'/>
          </svg>
          <span class='truncate'>Lưu ảnh</span>
        </button>

        <button
          id='scorecard-close-btn'
          type='button'
          class='flex items-center justify-center px-3.5 py-3 rounded-xl bg-white/20 hover:bg-white/30 active:translate-x-[1px] active:translate-y-[1px] text-white font-semibold text-[13.5px] backdrop-blur-sm border-2 border-white/60 shadow-[2.5px_3px_0px_rgba(0,0,0,0.3)] transition-transform cursor-pointer'
          style='border-radius: 14px 16px 13px 15px / 15px 13px 16px 14px;'
        >
          <span>Đóng</span>
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    {
      const modal = document.getElementById('game-modal');
      const frame = document.getElementById('modal-game-frame');
      const closeBtn = document.getElementById('modal-close-btn');

      const scorecardModal = document.getElementById('scorecard-modal');
      const scorecardImg = document.getElementById('scorecard-img');
      const scorecardShareBtn = document.getElementById('scorecard-share-btn');
      const scorecardSaveBtn = document.getElementById('scorecard-save-btn');
      const scorecardCloseBtn = document.getElementById('scorecard-close-btn');
      const scorecardTopCloseBtn = document.getElementById('scorecard-top-close-btn');

      let currentBlobUrl = null;
      let currentFile = null;

      function closeGame() {
        if (!modal || !frame) return;
        frame.src = 'about:blank';
        modal.style.display = 'none';
        modal.classList.add('hidden');
        document.body.style.overflow = '';
        closeScorecard();
      }

      function openScorecard(blobUrl, filename) {
        if (!scorecardModal || !scorecardImg) return;
        currentBlobUrl = blobUrl;
        scorecardImg.src = blobUrl;
        scorecardModal.style.display = 'flex';
        scorecardModal.classList.remove('hidden');

        fetch(blobUrl)
          .then((r) => r.blob())
          .then((blob) => {
            currentFile = new File([blob], filename || 'stickerman-score.png', { type: 'image/png' });
          })
          .catch(() => {});
      }

      window.openScorecard = openScorecard;

      function closeScorecard() {
        if (!scorecardModal) return;
        scorecardModal.style.display = 'none';
        scorecardModal.classList.add('hidden');
      }

      scorecardCloseBtn?.addEventListener('click', closeScorecard);
      scorecardTopCloseBtn?.addEventListener('click', closeScorecard);

      // Nút Chia sẻ Mạng Xã Hội (Facebook, Zalo, Messages, AirDrop, Instagram, ...)
      scorecardShareBtn?.addEventListener('click', async () => {
        if (currentFile && navigator.canShare && navigator.canShare({ files: [currentFile] })) {
          try {
            await navigator.share({
              files: [currentFile],
              title: 'Stickman War',
              text: 'Kỷ lục Stickman War của tôi! Thử đánh bại tôi xem nào 🎮'
            });
          } catch (e) {
            console.log('Share dismissed or failed', e);
          }
        } else if (navigator.share) {
          try {
            await navigator.share({
              title: 'Stickman War',
              text: 'Kỷ lục Stickman War của tôi! 🎮',
              url: window.location.href
            });
          } catch (e) {}
        } else if (currentBlobUrl) {
          // Fallback download if share not supported
          saveImageDirectly();
        }
      });

      function saveImageDirectly() {
        if (currentBlobUrl) {
          const a = document.createElement('a');
          a.href = currentBlobUrl;
          a.download = currentFile?.name || 'stickerman-score.png';
          document.body.appendChild(a);
          a.click();
          a.remove();
        }
      }

      scorecardSaveBtn?.addEventListener('click', saveImageDirectly);

      window.closeGame = closeGame;

      function setHomeButtonVisible(visible) {
        if (closeBtn) {
          closeBtn.style.display = visible ? 'flex' : 'none';
        }
      }
      window.setHomeButtonVisible = setHomeButtonVisible;

      if (closeBtn) {
        closeBtn.onclick = (e) => {
          e.preventDefault();
          closeGame();
        };
      }

      function setupIframe() {
        try {
          const win = frame.contentWindow;
          const doc = frame.contentDocument || win?.document;
          if (!win || !doc) return;

          win.focus();

          // Tối ưu viewport chống zoom quá cỡ
          let meta = doc.querySelector('meta[name="viewport"]');
          if (meta) {
            meta.setAttribute('content', 'width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover');
          }

          // Chặn double-tap zoom trên WebKit
          doc.addEventListener('dblclick', (e) => e.preventDefault(), { passive: false });

          // Kiểm soát ẩn/hiện nút Home góc trên: Khi thẻ kết game/start card xuất hiện thì ẩn nút nổi (vì đã có nút Trang chủ bên trong thẻ)
          function checkCardState() {
            try {
              const hasCard = !!(
                doc.querySelector('.card.show') ||
                doc.querySelector('#overlay.on') ||
                doc.querySelector('.modal.show') ||
                doc.querySelector('#startCard.show') ||
                doc.querySelector('#endCard.show')
              );
              setHomeButtonVisible(!hasCard);
            } catch (e) {}
          }

          try {
            const obs = new win.MutationObserver(checkCardState);
            obs.observe(doc.body, { attributes: true, subtree: true, attributeFilter: ['class', 'style'] });
            checkCardState();
            setTimeout(checkCardState, 200);
          } catch (e) {}

          // Bắt sự kiện thoát game
          doc.addEventListener('click', (ev) => {
            const a = ev.target.closest('a');
            if (a) {
              const href = a.getAttribute('href');
              if (href === '/' || href === '/all' || href === 'index.html' || a.classList.contains('back') || a.classList.contains('exit')) {
                ev.preventDefault();
                ev.stopPropagation();
                closeGame();
                return;
              }
              // Chặn điều hướng trực tiếp sang file ảnh blob
              if (a.href && (a.href.startsWith('blob:') || a.download)) {
                ev.preventDefault();
                ev.stopPropagation();
                openScorecard(a.href, a.download || 'stickerman-score.png');
                return;
              }
            }
          }, true);

          // Bắt lệnh click tải ảnh từ code js của game và chuyển hướng sang popup xem ảnh chuẩn mobile
          const origClick = win.HTMLAnchorElement.prototype.click;
          win.HTMLAnchorElement.prototype.click = function() {
            if (this.href && (this.href.startsWith('blob:') || this.download)) {
              openScorecard(this.href, this.download || 'stickerman-score.png');
              return;
            }
            return origClick.apply(this, arguments);
          };
        } catch (err) {
          console.warn('Iframe setup error', err);
        }
      }

      function openGame(slug) {
        if (!modal || !frame) return;
        frame.src = `/games/${slug}.html`;
        modal.style.display = 'block';
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        setHomeButtonVisible(false);

        frame.onload = setupIframe;
      }

      // Also listen for popstate or messages
      window.addEventListener('message', (ev) => {
        if (ev.data === 'close-game' || ev.data?.type === 'close-game') closeGame();
        if (ev.data?.type === 'show-scorecard') openScorecard(ev.data.url, ev.data.filename);
        if (ev.data?.type === 'set_home_btn') setHomeButtonVisible(ev.data.visible);
      });

      document.querySelectorAll('[data-game-slug]').forEach((card) => {
        card.addEventListener('click', (e) => {
          e.preventDefault();
          const slug = card.getAttribute('data-game-slug');
          if (slug) {
            openGame(slug);
          }
        });
      });

      // Quick Action Buttons
      const allCards = Array.from(document.querySelectorAll('[data-game-slug]'));
      const quickBtn = document.getElementById('quick-play-btn');
      const topPickBtn = document.getElementById('top-pick-btn');

      quickBtn?.addEventListener('click', () => {
        if (allCards.length > 0) {
          const randomCard = allCards[Math.floor(Math.random() * allCards.length)];
          const slug = randomCard.getAttribute('data-game-slug');
          if (slug) openGame(slug);
        }
      });

      topPickBtn?.addEventListener('click', () => {
        openGame('punching');
      });

      // Notification Bell Toast Click Handler
      const notifBellBtn = document.getElementById('notif-bell-btn');
      notifBellBtn?.addEventListener('click', () => {
        alert('🔔 Stickman War: Chào mừng bạn! Toàn bộ 20 mini-game đã sẵn sàng chơi mượt mà 100% không cần mạng.');
      });
    }
  </script>
</Base>
