---
import GithubIcon from '~/components/GithubIcon.astro';
import Logo from '~/components/Logo.astro';
import Base from '~/layouts/Base.astro';
import { games } from '~/lib/games';
import { absoluteUrl, SITE } from '~/lib/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: SITE.name,
  itemListElement: games.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: absoluteUrl(`/${g.slug}`),
    name: g.name,
  })),
};
---

<Base title={`${SITE.name} · ${SITE.tagline}`} description={SITE.description} path='/' jsonLd={jsonLd}>
  <main class='mx-auto max-w-[1120px] px-4 pt-[calc(env(safe-area-inset-top,0px)+1.5rem)] pb-[calc(env(safe-area-inset-bottom,0px)+3rem)] sm:px-8 sm:pt-16'>
    <section class='grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4'>
      <header
        class='col-span-2 flex flex-col justify-center rounded-2xl border border-amber-ink/20 bg-butter-soft p-5 sm:px-7 sm:py-6'
      >
        <div class='flex items-center gap-5 sm:gap-6'>
          <Logo class='size-14 shrink-0 sm:size-[72px]' />
          <h1 class='font-display text-[22px] leading-[1.12] text-balance sm:text-[30px]'>
            Small, silly games for the browser.
          </h1>
        </div>
        <p class='mt-4 max-w-[40ch] text-[14px] leading-snug text-pretty text-stone-500 sm:text-[15px]'>
          Free, no ads, no sign-ups, nothing to install.
        </p>

        <div class='mt-4 flex flex-wrap items-center gap-2'>
          <a
            href='/make'
            class='font-display flex h-10 items-center rounded-xl border border-amber-ink/25 bg-butter px-4 text-[15px] text-umber transition hover:bg-butter-hi active:scale-[.98]'
          >
            Make your own game
          </a>
          <a
            href={SITE.github}
            class='font-display flex h-10 items-center gap-2 rounded-xl border border-neutral-200 bg-white px-4 text-[15px] transition hover:bg-[#f5f5f5] active:scale-[.98]'
          >
            <GithubIcon class='size-[17px]' />
            GitHub
          </a>
        </div>
      </header>

      {
        games.map((game) => (
          <a
            href={`/${game.slug}`}
            class='group relative flex flex-col rounded-2xl border border-neutral-200 bg-white p-2 transition-colors hover:border-neutral-300'
          >
            <div class='relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-xl bg-white'>
              <img src={`/thumbs/${game.slug}.webp`} alt='' loading='lazy' class='h-[78%] w-[84%] object-contain' />
            </div>
            <div class='px-2 pt-3 pb-2'>
              <h2 class='font-display text-[17px] leading-tight sm:text-[18px]'>{game.name}</h2>
              <p class='mt-1 text-[13px] leading-snug text-neutral-500'>{game.tagline}</p>
            </div>
          </a>
        ))
      }

      <a
        href='/make'
        class='group flex flex-col rounded-2xl border-2 border-dashed border-neutral-200 p-2 transition-colors hover:border-amber-ink/40 hover:bg-butter-soft/40'
      >
        <div class='flex aspect-[4/3] items-center justify-center'>
          <span
            class='grid size-14 place-items-center rounded-full border border-amber-ink/20 bg-butter text-umber sm:size-16'
          >
            <svg viewBox='0 0 24 24' class='size-7' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round'>
              <path d='M12 5v14M5 12h14'></path>
            </svg>
          </span>
        </div>
        <div class='px-2 pt-3 pb-2'>
          <h2 class='font-display text-[17px] leading-tight sm:text-[18px]'>Make & submit a game</h2>
          <p class='mt-1 text-[13px] leading-snug text-neutral-500'>Build it with Claude Code, we put it on the site</p>
        </div>
      </a>
    </section>

    <footer class='mt-20 flex flex-col items-center gap-1 text-center text-[13.5px] text-neutral-400'>
      <span>
        {games.length} games so far.{' '}
        <a href='/make' class='underline decoration-neutral-300 underline-offset-2 transition-colors hover:text-neutral-900'>
          Add yours
        </a>.
      </span>
      <a href={SITE.author.url} class='transition-colors hover:text-neutral-900'>Made by {SITE.author.name}</a>
    </footer>
  </main>
</Base>
