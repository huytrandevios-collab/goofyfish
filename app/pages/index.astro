---
import GithubIcon from '~/components/GithubIcon.astro';
import Logo from '~/components/Logo.astro';
import StickmanHero from '~/components/StickmanHero.astro';
import Base from '~/layouts/Base.astro';
import { games } from '~/lib/games';
import { absoluteUrl, SITE } from '~/lib/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: SITE.name,
  itemListElement: games.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: absoluteUrl(`/${g.slug}`),
    name: g.name,
  })),
};
---

<Base title={`${SITE.name} · ${SITE.tagline}`} description={SITE.description} path='/' jsonLd={jsonLd}>
  <!-- Top App Bar: Stickman War & Notification Bell (Locked / Sticky at top by default) -->
  <header class='sticky top-0 z-30 w-full bg-[#f7f7f5]/95 backdrop-blur-md border-b border-stone-800/10 shadow-[0_1px_4px_rgba(0,0,0,0.04)]'>
    <nav class='mx-auto max-w-[1120px] px-4 pt-[calc(env(safe-area-inset-top,0px)+0.2rem)] pb-1.5 flex items-center justify-between sm:px-8'>
      <div class='flex items-center gap-2.5'>
        <!-- Official Stickman War App Icon with Comic Border -->
        <div class='relative flex size-9.5 shrink-0 items-center justify-center overflow-hidden rounded-xl border-2 border-stone-800 shadow-[2px_2.5px_0px_#1f2329]' style='border-radius: 11px 13px 10px 12px / 13px 11px 12px 10px;'>
          <img src="/favicon-192.png" alt="Stickman War Icon" class="size-full object-cover" />
        </div>
        <div>
          <h1 class='font-display text-[20px] font-bold tracking-tight text-stone-900 sm:text-[23px] leading-none'>
            Stickman War
          </h1>
          <p class='text-[11px] font-medium text-amber-900/80 leading-tight mt-0.5'>
            Arcade Battle Edition
          </p>
        </div>
      </div>

      <!-- Actions: Game Center Rank, Smart Bell, Settings -->
      <div class='flex items-center gap-2'>
        <!-- 1. Game Center Rank Button -->
        <button
          id='rank-btn'
          type='button'
          aria-label='Bảng xếp hạng Game Center'
          class='group relative flex size-9.5 items-center justify-center rounded-xl border-2 border-stone-800 bg-[#fef9c3] transition-all hover:bg-amber-100 active:translate-x-[1px] active:translate-y-[1px] shadow-[2.5px_3px_0px_#1f2329]'
          style='border-radius: 12px 14px 11px 13px / 14px 12px 13px 11px;'
        >
          <!-- Trophy Icon -->
          <svg viewBox="0 0 24 24" class="size-4.5 text-amber-700 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h2"/>
            <path d="M18 9h2a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-2"/>
            <path d="M4 22h16"/>
            <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
            <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
            <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
          </svg>
          <span class="absolute -bottom-1 -right-1 flex items-center justify-center rounded-full bg-amber-500 border border-stone-900 px-1 text-[8.5px] font-black text-white leading-tight">TOP</span>
        </button>

        <!-- 2. Smart Notification Bell Button -->
        <button
          id='notif-bell-btn'
          type='button'
          aria-label='Thông báo thông minh'
          class='group relative flex size-9.5 items-center justify-center rounded-xl border-2 border-stone-800 bg-white transition-all hover:bg-amber-50 active:translate-x-[1px] active:translate-y-[1px] shadow-[2.5px_3px_0px_#1f2329]'
          style='border-radius: 12px 14px 11px 13px / 14px 12px 13px 11px;'
        >
          <svg viewBox="0 0 24 24" class="size-4.5 text-stone-800 transition-transform group-hover:rotate-12 group-active:scale-90" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
            <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
          </svg>
          <!-- Active Notification Badge Counter -->
          <span id="notif-badge-counter" class="absolute -top-1 -right-1 flex size-4.5 items-center justify-center rounded-full border border-stone-900 bg-rose-500 text-[9.5px] font-black text-white leading-none shadow-xs">
            3
          </span>
        </button>

        <!-- 3. Settings Button (Bên cạnh nút chuông) -->
        <button
          id='settings-btn'
          type='button'
          aria-label='Cài đặt'
          class='group relative flex size-9.5 items-center justify-center rounded-xl border-2 border-stone-800 bg-white transition-all hover:bg-stone-50 active:translate-x-[1px] active:translate-y-[1px] shadow-[2.5px_3px_0px_#1f2329]'
          style='border-radius: 12px 14px 11px 13px / 14px 12px 13px 11px;'
        >
          <svg viewBox="0 0 24 24" class="size-4.5 text-stone-800 transition-transform group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </button>
      </div>
    </nav>
  </header>

  <main class='mx-auto max-w-[1120px] px-4 pt-1 pb-[calc(env(safe-area-inset-bottom,0px)+0.25rem)] sm:px-8 sm:pt-2'>
    <section class='grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4'>
      <header
        class='col-span-2 flex flex-col justify-center rounded-2xl border-2 border-stone-800 bg-butter-soft p-3 sm:p-5 shadow-[3.5px_4px_0px_#1f2329]'
        style='border-radius: 20px 24px 22px 26px / 24px 20px 26px 22px;'
      >
        <StickmanHero />
      </header>

      <!-- Games Section Header -->
      <div class='col-span-2 flex items-center justify-between px-1 pt-1.5 pb-0.5'>
        <h2 class='font-display text-[15.5px] font-bold text-stone-900 tracking-tight flex items-center gap-1.5'>
          <span>🎮</span>
          <span>Chọn Trò Chơi</span>
        </h2>
        <span class='text-[11px] font-bold text-amber-950 bg-amber-100/90 border border-amber-900/20 px-2.5 py-0.5 rounded-full shadow-[1px_1px_0px_#1f2329]'>
          20 Thử Thách
        </span>
      </div>

      {
        games.map((game) => (
          <a
            href={`/${game.slug}`}
            data-game-slug={game.slug}
            data-game-name={game.name}
            class='group relative flex flex-col rounded-2xl border-2 border-stone-800/90 bg-white p-2 transition-all hover:-translate-y-0.5 active:translate-x-[1px] active:translate-y-[1px] shadow-[3px_3.5px_0px_#1f2329]'
            style='border-radius: 18px 22px 19px 23px / 22px 18px 23px 19px;'
          >
            <div class='relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-xl bg-neutral-50/60 border border-stone-200/80'>
              <img src={`/thumbs/${game.slug}.webp`} alt='' loading='lazy' class='h-[78%] w-[84%] object-contain' />
            </div>
            <div class='px-2 pt-3 pb-2'>
              <h2 class='font-display text-[17px] leading-tight sm:text-[18px] text-stone-900'>{game.name}</h2>
              <p class='mt-1 text-[13px] leading-snug text-neutral-600'>{game.tagline}</p>
            </div>
          </a>
        ))
      }
    </section>

    <footer class='mt-3 pb-1 flex flex-col items-center text-center'>
      <p class='text-[12px] font-medium leading-tight text-stone-600'>Copyright © Huy Tran</p>
      <p class='mt-0.5 text-[10.5px] leading-tight text-stone-400'>Stickman War Arcade · All rights reserved</p>
    </footer>
  </main>

  <!-- Full-screen In-App Game Player for Mobile -->
  <div id='game-modal' class='fixed inset-0 z-50 hidden bg-white' style='position: fixed; inset: 0; z-index: 9999; display: none;'>
    <iframe
      id='modal-game-frame'
      title='Game View'
      allow='camera; microphone; fullscreen; autoplay; web-share; clipboard-write'
      class='w-full h-full border-0 block bg-white'
    ></iframe>

    <!-- Nút Về Trang Chủ đặt SAU iframe để luôn nằm trên cùng (z-index 99999) -->
    <button
      id='modal-close-btn'
      type='button'
      aria-label='Về trang chủ'
      onclick='window.closeGame ? window.closeGame() : (document.getElementById("game-modal").style.display = "none")'
      style='position: fixed; top: calc(env(safe-area-inset-top, 0px) + 10px); right: 16px; z-index: 99999; pointer-events: auto;'
      class='flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-stone-900/90 active:scale-90 text-white text-[12.5px] font-semibold shadow-2xl backdrop-blur-md border border-white/30 cursor-pointer select-none'
    >
      <svg class='w-3.5 h-3.5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'>
        <path d='M18 6 6 18M6 6l12 12'/>
      </svg>
      <span>Trang chủ</span>
    </button>
  </div>

  <!-- Scorecard Preview Modal: Hiển thị Báo Cáo Kết Quả & Tranh Minh Họa chuẩn tỉ lệ di động -->
  <div
    id='scorecard-modal'
    class='fixed inset-0 z-[100000] hidden items-center justify-center p-3 bg-black/85 backdrop-blur-md transition-opacity select-none'
    style='display: none; position: fixed; inset: 0; z-index: 100000;'
  >
    <div class='relative max-w-sm w-full flex flex-col items-center animate-in fade-in zoom-in-95 duration-200'>
      <!-- Header -->
      <div class='flex items-center justify-between w-full px-2 mb-2 text-white'>
        <div class='flex items-center gap-2'>
          <span class='text-lg'>🏆</span>
          <div>
            <h3 class='text-[15px] font-bold text-amber-300 leading-tight'>Báo Cáo Thành Tích</h3>
            <p class='text-[11px] text-stone-300 leading-tight'>Tranh minh họa ván đấu của bạn</p>
          </div>
        </div>
        <button
          id='scorecard-top-close-btn'
          type='button'
          class='w-8 h-8 flex items-center justify-center rounded-full bg-white/20 hover:bg-white/30 text-white text-base active:scale-90 cursor-pointer transition-transform'
        >
          ✕
        </button>
      </div>

      <!-- Ảnh kết quả minh họa hiển thị trọn vẹn, co giãn theo chiều cao điện thoại với viền vẽ tay -->
      <div class='relative flex items-center justify-center w-full max-h-[66vh] overflow-hidden rounded-2xl bg-[#f7f7f5] shadow-[4px_5px_0px_#1f2329] border-2 border-stone-800' style='border-radius: 20px 24px 22px 26px / 24px 20px 26px 22px;'>
        <img
          id='scorecard-img'
          alt='Báo Cáo Minh Họa Sticker Man'
          class='w-auto max-h-[66vh] max-w-[88vw] object-contain block'
        />
      </div>

      <!-- Nút thao tác Lưu ảnh / Chia sẻ mạng xã hội / Đóng phong cách vẽ tay -->
      <div class='mt-3 flex w-full max-w-[88vw] gap-2'>
        <button
          id='scorecard-share-btn'
          type='button'
          class='flex-1 flex items-center justify-center gap-1.5 py-3 px-3 rounded-xl bg-amber-300 hover:bg-amber-200 active:translate-x-[1px] active:translate-y-[1px] text-stone-900 font-bold text-[13.5px] border-2 border-stone-800 shadow-[2.5px_3px_0px_#1f2329] transition-transform cursor-pointer'
          style='border-radius: 14px 16px 13px 15px / 15px 13px 16px 14px;'
        >
          <!-- Share Icon -->
          <svg class='w-4.5 h-4.5 shrink-0' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.3' stroke-linecap='round' stroke-linejoin='round'>
            <path d='M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8'/>
            <polyline points='16 6 12 2 8 6'/>
            <line x1='12' y1='2' x2='12' y2='15'/>
          </svg>
          <span class='truncate'>Chia sẻ MXH</span>
        </button>

        <button
          id='scorecard-save-btn'
          type='button'
          class='flex items-center justify-center gap-1.5 py-3 px-3 rounded-xl bg-white hover:bg-stone-50 active:translate-x-[1px] active:translate-y-[1px] text-stone-900 font-bold text-[13.5px] border-2 border-stone-800 shadow-[2.5px_3px_0px_#1f2329] transition-transform cursor-pointer'
          style='border-radius: 14px 16px 13px 15px / 15px 13px 16px 14px;'
        >
          <!-- Download Icon -->
          <svg class='w-4.5 h-4.5 shrink-0' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.3' stroke-linecap='round' stroke-linejoin='round'>
            <path d='M12 3v12'/>
            <path d='m7 10 5 5 5-5'/>
            <path d='M5 21h14'/>
          </svg>
          <span class='truncate'>Lưu ảnh</span>
        </button>

        <button
          id='scorecard-close-btn'
          type='button'
          class='flex items-center justify-center px-3.5 py-3 rounded-xl bg-white/20 hover:bg-white/30 active:translate-x-[1px] active:translate-y-[1px] text-white font-semibold text-[13.5px] backdrop-blur-sm border-2 border-white/60 shadow-[2.5px_3px_0px_rgba(0,0,0,0.3)] transition-transform cursor-pointer'
          style='border-radius: 14px 16px 13px 15px / 15px 13px 16px 14px;'
        >
          <span>Đóng</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ================= 1. SMART NOTIFICATION MODAL ================= -->
  <div
    id='notif-modal'
    class='fixed inset-0 z-[100000] hidden items-center justify-center p-3 bg-black/80 backdrop-blur-md transition-opacity select-none'
    style='display: none; position: fixed; inset: 0; z-index: 100000;'
  >
    <div class='relative max-w-sm w-full flex flex-col rounded-2xl bg-[#f7f7f5] border-2 border-stone-800 shadow-[4px_5px_0px_#1f2329] p-4 animate-in fade-in zoom-in-95 duration-200' style='border-radius: 20px 24px 22px 26px / 24px 20px 26px 22px;'>
      <!-- Header -->
      <div class='flex items-center justify-between pb-3 border-b-2 border-stone-800/10'>
        <div class='flex items-center gap-2'>
          <div class='flex size-8 items-center justify-center rounded-xl bg-amber-100 border border-stone-800/30 text-amber-700 shadow-xs'>
            <svg viewBox="0 0 24 24" class="size-4.5" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
              <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
            </svg>
          </div>
          <div>
            <h3 class='font-display text-[16px] font-bold text-stone-900 leading-tight'>Thông Báo Thông Minh</h3>
            <p class='text-[10.5px] font-medium text-amber-900/80 leading-tight'>Cập nhật nhiệm vụ & điểm thưởng</p>
          </div>
        </div>
        <div class='flex items-center gap-1.5'>
          <button id='notif-mark-all-read-btn' type='button' class='text-[11px] font-bold text-amber-800 bg-amber-100/90 hover:bg-amber-200 px-2 py-1 rounded-lg border border-amber-800/20 active:scale-95'>
            Đã đọc
          </button>
          <button id='notif-close-btn' type='button' class='size-7 flex items-center justify-center rounded-full bg-stone-200/80 hover:bg-stone-300 text-stone-700 active:scale-90 font-bold text-sm'>
            ✕
          </button>
        </div>
      </div>

      <!-- Smart Schedule Toggle Box -->
      <div class='mt-3 flex items-center justify-between p-2.5 rounded-xl bg-amber-50 border border-amber-900/15 shadow-xs'>
        <div class='flex items-center gap-2'>
          <span class='text-base'>⏰</span>
          <div>
            <div class='text-[12px] font-bold text-stone-900 leading-tight'>Nhắc Nhở Luyện Tập</div>
            <div class='text-[10px] text-stone-500 leading-tight'>Thông báo vào 12:00 & 20:00</div>
          </div>
        </div>
        <label class='relative inline-flex items-center cursor-pointer'>
          <input id='smart-reminder-toggle' type='checkbox' checked class='sr-only peer' />
          <div class='w-9 h-5 bg-stone-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[""] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-stone-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-amber-500'></div>
        </label>
      </div>

      <!-- Notifications List -->
      <div class='mt-3 max-h-[50vh] overflow-y-auto flex flex-col gap-2.5 pr-0.5'>
        <!-- Item 1: Daily Reward -->
        <div id='notif-item-reward' class='flex flex-col gap-1.5 p-2.5 rounded-xl bg-white border-2 border-stone-800 shadow-[2px_2.5px_0px_#1f2329]' style='border-radius: 12px 14px 11px 13px / 14px 12px 13px 11px;'>
          <div class='flex items-start justify-between'>
            <div class='flex items-center gap-1.5'>
              <span class='text-sm'>🎁</span>
              <span class='text-[12px] font-bold text-stone-900'>Điểm Danh Hôm Nay</span>
            </div>
            <span class='text-[9.5px] font-semibold text-stone-600 bg-stone-100 px-1.5 py-0.5 rounded'>Mới</span>
          </div>
          <p class='text-[11px] text-stone-600 leading-snug'>
            Nhận ngay <strong class='text-amber-800'>+50 War Points</strong> danh dự hôm nay để tăng tốc thăng hạng Rank!
          </p>
          <div class='flex justify-end pt-0.5'>
            <button id='notif-claim-btn' type='button' class='flex items-center gap-1 px-2.5 py-1 rounded-lg bg-amber-400 hover:bg-amber-300 text-stone-900 text-[11px] font-bold border border-stone-800 shadow-xs active:translate-y-[1px]'>
              <span>Nhận +50 Đ</span>
            </button>
          </div>
        </div>

        <!-- Item 2: Daily Quest -->
        <div class='flex flex-col gap-1.5 p-2.5 rounded-xl bg-white border-2 border-stone-800 shadow-[2px_2.5px_0px_#1f2329]' style='border-radius: 13px 11px 14px 12px / 11px 14px 12px 13px;'>
          <div class='flex items-start justify-between'>
            <div class='flex items-center gap-1.5'>
              <span class='text-sm'>⚔️</span>
              <span class='text-[12px] font-bold text-stone-900'>Nhiệm Vụ Tác Chiến</span>
            </div>
            <span class='text-[9.5px] font-semibold text-amber-700 bg-amber-50 px-1.5 py-0.5 rounded'>Hôm nay</span>
          </div>
          <p class='text-[11px] text-stone-600 leading-snug'>
            Thử thách đặc biệt: Hạ gục 15 tên côn đồ trong <strong class='text-stone-800'>Goon Rush</strong> để mở danh hiệu Chiến Binh!
          </p>
          <div class='flex justify-end pt-0.5'>
            <button id='notif-play-quest-btn' type='button' class='flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#fde68a] hover:bg-amber-300 text-stone-900 text-[11px] font-bold border border-stone-800 shadow-xs active:translate-y-[1px]'>
              <span>Vào Trận</span>
            </button>
          </div>
        </div>

        <!-- Item 3: Game Center Rank Alert -->
        <div class='flex flex-col gap-1.5 p-2.5 rounded-xl bg-white border-2 border-stone-800 shadow-[2px_2.5px_0px_#1f2329]' style='border-radius: 12px 14px 11px 13px / 14px 12px 13px 11px;'>
          <div class='flex items-start justify-between'>
            <div class='flex items-center gap-1.5'>
              <span class='text-sm'>🏆</span>
              <span class='text-[12px] font-bold text-stone-900'>Xếp Hạng Game Center</span>
            </div>
            <span class='text-[9.5px] font-semibold text-stone-600 bg-stone-100 px-1.5 py-0.5 rounded'>Mùa 1</span>
          </div>
          <p class='text-[11px] text-stone-600 leading-snug'>
            Đua Top mùa 1 đang diễn ra sôi động! Tích lũy đủ <strong class='text-amber-800'>250 điểm</strong> để mở khóa Rank Vàng 🥇.
          </p>
          <div class='flex justify-end pt-0.5'>
            <button id='notif-view-rank-btn' type='button' class='flex items-center gap-1 px-2.5 py-1 rounded-lg bg-stone-100 hover:bg-stone-200 text-stone-900 text-[11px] font-bold border border-stone-800 shadow-xs active:translate-y-[1px]'>
              <span>Xem Rank</span>
            </button>
          </div>
        </div>

        <!-- Item 4: Combat Tips -->
        <div class='flex flex-col gap-1 p-2.5 rounded-xl bg-white border-2 border-stone-800 shadow-[2px_2.5px_0px_#1f2329]' style='border-radius: 13px 11px 14px 12px / 11px 14px 12px 13px;'>
          <div class='flex items-center gap-1.5'>
            <span class='text-sm'>💡</span>
            <span class='text-[12px] font-bold text-stone-900'>Mẹo Pro Gamer</span>
          </div>
          <p class='text-[11px] text-stone-600 leading-snug'>
            Trong <strong>Ninja Swing</strong>, hãy chạm thả móc khi đạt góc 45° để bay xa và ghi điểm số tối đa!
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= 2. SETTINGS MODAL ================= -->
  <div
    id='settings-modal'
    class='fixed inset-0 z-[100000] hidden items-center justify-center p-3 bg-black/80 backdrop-blur-md transition-opacity select-none'
    style='display: none; position: fixed; inset: 0; z-index: 100000;'
  >
